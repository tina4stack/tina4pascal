# ---- android apk / deploy ----------------------------------------------------
cmd_apk() {
  sh "$ROOT/android/build.sh"
  ANDROID_SDK="$ANDROID_SDK" \
    TINA4_KEYSTORE="${TINA4_KEYSTORE:-}" TINA4_KEY_ALIAS="${TINA4_KEY_ALIAS:-}" \
    TINA4_KS_PASS="${TINA4_KS_PASS:-}" TINA4_KEY_PASS="${TINA4_KEY_PASS:-}" \
    sh "$ROOT/android/build-apk.sh"
}

# keygen [out.jks] [alias] — create a release signing keystore (prompts for the
# passwords + identity). One-time; keep the file + passwords safe (Play requires
# the SAME key for every update).
cmd_keygen() {
  ks="${1:-$ROOT/android/release.jks}"; alias="${2:-tina4}"
  command -v keytool >/dev/null 2>&1 || die "keytool not found (install a JDK)"
  [ -f "$ks" ] && die "keystore already exists: $ks (delete it to regenerate)"
  say "→ creating release keystore ${D}$ks${Z} (alias $alias)"
  keytool -genkeypair -v -keystore "$ks" -alias "$alias" \
    -keyalg RSA -keysize 2048 -validity 10000 || die "keytool failed"
  ok "keystore created: $ks"
  say "To sign a release build, export these (then: tina4pascal release):"
  say "  export TINA4_KEYSTORE=\"$ks\""
  say "  export TINA4_KEY_ALIAS=\"$alias\""
  say "  export TINA4_KS_PASS=…   # store password you just set"
  say "  export TINA4_KEY_PASS=…  # key password (omit if same as store)"
}

# release — build a release-SIGNED APK (needs the TINA4_KEYSTORE env, see keygen)
cmd_release() {
  [ -n "${TINA4_KEYSTORE:-}" ] \
    || die "no release keystore — run: tina4pascal keygen, then export TINA4_KEYSTORE/TINA4_KEY_ALIAS/TINA4_KS_PASS"
  cmd_apk
  ok "release APK → $ROOT/android/tina4pascal-release.apk"
}

cmd_deploy() {
  command -v adb >/dev/null 2>&1 || die "adb not found"
  [ "$(adb devices | grep -cw device)" -gt 0 ] || die "no device attached (adb devices)"
  cmd_apk
  say "→ installing…"
  adb install -r "$ROOT/android/tina4pascal-debug.apk"
  adb shell am start -n com.tina4.pascal/.MainActivity
  ok "launched on device"
}

# ---- iOS build / deploy ------------------------------------------------------
# The device identifier for install/launch/screenshot. Everything goes through
# `xcrun devicectl` (CoreDevice, iOS 17+), so prefer the devicectl identifier of
# the first available iPhone/iPad; fall back to a USB idevice_id UDID.
ios_udid() {
  [ -n "${IOS_UDID:-}" ] && { echo "$IOS_UDID"; return; }
  id="$(xcrun devicectl list devices 2>/dev/null \
        | grep -iE 'available' | grep -iE 'iphone|ipad' \
        | grep -oE '[0-9A-Fa-f]{8}-([0-9A-Fa-f]{4}-){3}[0-9A-Fa-f]{12}' | head -1)"
  [ -n "$id" ] && { echo "$id"; return; }
  idevice_id -l 2>/dev/null | head -1
}

# static lib (Pascal engine) → xcodegen project → xcodebuild → install + launch
cmd_ios() {
  command -v xcodebuild >/dev/null 2>&1 || die "Xcode not found — run: tina4pascal setup ios"
  udid="$(ios_udid)"; [ -n "$udid" ] || die "no iOS device attached (idevice_id -l)"
  say "→ building the Pascal engine (libtina4ios.a)…"
  sh "$IOS_DIR/build.sh" >/dev/null 2>&1 || die "engine build failed (run ios/build.sh to see errors)"
  if [ ! -d "$IOS_DIR/Tina4Pascal.xcodeproj" ]; then
    command -v xcodegen >/dev/null 2>&1 || die "xcodegen not found — run: tina4pascal setup ios"
    ( cd "$IOS_DIR" && xcodegen >/dev/null )
  fi
  say "→ xcodebuild (sign for device)…"
  xcodebuild -project "$IOS_DIR/Tina4Pascal.xcodeproj" -scheme Tina4Pascal \
    -destination "generic/platform=iOS" -allowProvisioningUpdates build 2>&1 \
    | grep -qE "BUILD SUCCEEDED" || die "xcodebuild failed (open the project in Xcode to set your team)"
  app="$(xcodebuild -project "$IOS_DIR/Tina4Pascal.xcodeproj" -scheme Tina4Pascal \
    -destination "generic/platform=iOS" -showBuildSettings 2>/dev/null \
    | awk -F' = ' '/ TARGET_BUILD_DIR /{d=$2} / FULL_PRODUCT_NAME /{n=$2} END{print d"/"n}')"
  say "→ installing on $udid…"
  xcrun devicectl device install app --device "$udid" "$app" >/dev/null 2>&1 \
    || die "install failed (is the iPhone unlocked?)"
  xcrun devicectl device process launch --device "$udid" "$IOS_BUNDLE" >/dev/null 2>&1 || true
  ok "launched on device"
}

# launch <target>  — bring the already-installed app to the foreground, no build.
# (The IDE needs a fast "run" that skips the rebuild; also used to re-foreground
#  the app before a screenshot.)
cmd_launch() {
  plat="${1:-ios}"
  case "$plat" in
    ios)
      udid="$(ios_udid)"; [ -n "$udid" ] || die "no iOS device attached (idevice_id / devicectl)"
      xcrun devicectl device process launch --terminate-existing --device "$udid" "$IOS_BUNDLE" >/dev/null 2>&1 \
        || die "launch failed (installed? iPhone unlocked?)"
      ok "launched $IOS_BUNDLE on device" ;;
    android)
      adb shell monkey -p "$ANDROID_PKG" -c android.intent.category.LAUNCHER 1 >/dev/null 2>&1 \
        && ok "launched $ANDROID_PKG" || die "launch failed (installed? emulator/device up?)" ;;
    macos)
      open "$ROOT/examples/htmlviewer/htmlviewer" 2>/dev/null && ok "launched macOS viewer" || die "build macos first" ;;
    *) die "launch: unsupported target '$plat' (ios|android|macos)" ;;
  esac
}

cmd_clean() { rm -rf "$BUILD" "$ROOT/android/out" "$ROOT/android/tina4pascal-debug.apk" "$IOS_DIR/build" "$IOS_DIR/app/libtina4ios.a"; ok "cleaned"; }

# ---- device screenshot / logs / debug loop ----------------------------------
adb_have_device() { [ "$(adb devices | grep -cw device)" -gt 0 ]; }

# screenshot [android|ios|macos] [out.png]   — grab the app screen for a target.
# (legacy order `screenshot out.png platform` still accepted)
cmd_screenshot() {
  a1="${1:-android}"; a2="${2:-}"
  case "$a1" in
    android|ios|macos|win64|windows|linux) plat="$a1"; out="${a2:-$ROOT/build/$a1.png}" ;;
    *) out="$a1"; plat="${a2:-android}" ;;    # legacy: out first
  esac
  mkdir -p "$(dirname "$out")"
  case "$plat" in
    ios)
      [ -x "$PMD3" ] || command -v pymobiledevice3 >/dev/null 2>&1 || die "pymobiledevice3 missing — run: tina4pascal setup ios"
      # pymobiledevice3 opens the iOS 17+ native tunnel itself; the phone must
      # be unlocked. No app focus needed — it grabs the whole screen.
      "$PMD3" developer dvt screenshot "$out" >/dev/null 2>&1 || die "iOS screenshot failed (unlock the iPhone?)"
      ok "iOS screenshot → $out" ;;
    macos)
      # bring the running app forward, then capture its window (no shadow, PNG)
      osascript -e 'tell application "Tina4Pascal" to activate' >/dev/null 2>&1 || \
        open "$BUILD/Tina4Pascal.app" >/dev/null 2>&1 || true
      sleep 1
      wid="$(GetWindowID Tina4Pascal --list 2>/dev/null | awk 'NR==1{print $1}')"
      if [ -n "$wid" ]; then screencapture -o -x -l"$wid" "$out"
      else screencapture -o -x "$out"; fi          # fall back to full screen
      ok "macOS screenshot → $out" ;;
    win64|windows|linux)
      die "no $plat screenshot yet — the $plat windowed shell is pending (see docs/ROADMAP.md); 'build $plat' cross-compiles the engine" ;;
    android|*)
      adb_have_device || die "no device attached (adb devices)"
      adb shell input keyevent KEYCODE_WAKEUP >/dev/null 2>&1 || true   # slept screen = black
      adb shell am start -n com.tina4.pascal/.MainActivity >/dev/null 2>&1 || true
      sleep 1
      adb exec-out screencap -p > "$out"
      ok "screenshot → $out" ;;
  esac
}

# on-device log tail: logcat [android|ios] [-f|N]
cmd_logs() {
  plat="${1:-android}"; shift 2>/dev/null || true
  case "$plat" in
    ios)
      # CoreDevice (iOS 17+) syslog over the tunnel — same transport as the
      # screenshots; idevicesyslog needs USB libimobiledevice and won't see a
      # network-paired phone. Filter to the app + its media stack.
      PMD3="$(command -v pymobiledevice3 2>/dev/null || echo "$HOME/.local/bin/pymobiledevice3")"
      { [ -x "$PMD3" ] || command -v pymobiledevice3 >/dev/null 2>&1; } \
        || die "pymobiledevice3 missing — run: tina4pascal setup ios"
      filt='Tina4Pascal|tina4|AVPlayer|CoreMedia|VideoToolbox'
      case "${1:-}" in
        -f|--follow) "$PMD3" syslog live 2>/dev/null | grep --line-buffered -iE "$filt" ;;
        *) tmp="$(mktemp)"
           "$PMD3" syslog live 2>/dev/null | grep --line-buffered -iE "$filt" > "$tmp" & p=$!
           sleep "${1:-5}"; kill "$p" 2>/dev/null || true
           tail -"${2:-60}" "$tmp"; rm -f "$tmp" ;;
      esac ;;
    android|*) cmd_logcat "$@" ;;
  esac
}

# Android logs. Filters to the app's own process when it's running; if it isn't
# (e.g. it just crashed), falls back to the crash channels so a FATAL EXCEPTION
# is never hidden by a too-narrow tag filter.
cmd_logcat() {
  adb_have_device || die "no device attached"
  pid="$(adb shell pidof "$ANDROID_PKG" 2>/dev/null | tr -d '\r ' | awk '{print $1}')"
  case "${1:-}" in
    -f|--follow)
      if [ -n "$pid" ]; then adb logcat --pid="$pid"
      else adb logcat -s AndroidRuntime:* DEBUG:* tina4:* ; fi ;;
    *)
      if [ -n "$pid" ]; then adb logcat -d --pid="$pid" | tail -"${1:-60}"
      else
        warn "$ANDROID_PKG not running — showing recent crashes"
        adb logcat -d -s AndroidRuntime:* DEBUG:* tina4:* | tail -"${1:-60}"
      fi ;;
  esac
}

# deploy [android|ios|macos]  — build + install/open + launch on that target.
cmd_run_target() {
  case "${1:-android}" in
    ios)   cmd_ios ;;
    macos) cmd_macos --run ;;
    android) cmd_deploy ;;
    win64|windows|linux) cmd_build "$1"; warn "$1 windowed shell is pending — engine cross-compiled only (docs/ROADMAP.md)" ;;
    *) die "deploy <android|ios|macos|win64|linux>" ;;
  esac
}

# debug [android|ios|macos] — build → install → launch → screenshot → tail log.
cmd_debug() {
  plat="${1:-android}"
  case "$plat" in
    android)
      adb_have_device || die "no device attached"
      cmd_apk
      adb install -r "$ROOT/android/tina4pascal-debug.apk" >/dev/null
      adb logcat -c || true
      adb shell am force-stop com.tina4.pascal >/dev/null 2>&1 || true
      adb shell input keyevent KEYCODE_WAKEUP >/dev/null 2>&1 || true
      adb shell am start -n com.tina4.pascal/.MainActivity >/dev/null 2>&1
      sleep 3
      cmd_screenshot android "$ROOT/build/device.png"
      say "${B}--- device log (app pid, or crashes if it died) ---${Z}"
      cmd_logcat 40 ;;
    ios)
      cmd_ios
      sleep 2
      cmd_screenshot ios "$ROOT/build/ios.png"
      cmd_logs ios ;;
    macos)
      cmd_macos --run
      sleep 1
      cmd_screenshot macos "$ROOT/build/macos.png" ;;
    *) die "debug <android|ios|macos>" ;;
  esac
}

# ---- app input (drive the running app: navigate, click, type) ----------------
# tap <platform> X Y   — a click/tap at screen coords (device px)
cmd_tap() {
  plat="${1:-android}"; x="${2:-}"; y="${3:-}"
  [ -n "$x" ] && [ -n "$y" ] || die "usage: tina4pascal tap <android|ios|macos> X Y"
  case "$plat" in
    android) adb_have_device || die "no device"; adb shell input tap "$x" "$y"; ok "tap $x,$y" ;;
    ios)     ios_input_note ;;
    macos)   macos_note ;;
    *) die "tap <android|ios|macos> X Y" ;;
  esac
}
# swipe <platform> X1 Y1 X2 Y2 [ms]  — scroll / drag
cmd_swipe() {
  plat="${1:-android}"; shift 2>/dev/null || true
  [ $# -ge 4 ] || die "usage: tina4pascal swipe <platform> X1 Y1 X2 Y2 [ms]"
  case "$plat" in
    android) adb_have_device || die "no device"; adb shell input swipe "$1" "$2" "$3" "$4" "${5:-300}"; ok "swipe" ;;
    ios)     ios_input_note ;;
    macos)   macos_note ;;
    *) die "swipe <platform> X1 Y1 X2 Y2 [ms]" ;;
  esac
}
# text <platform> "string"  — type into the focused field
cmd_text() {
  plat="${1:-android}"; shift 2>/dev/null || true
  [ $# -ge 1 ] || die "usage: tina4pascal text <platform> \"...\""
  case "$plat" in
    android) adb_have_device || die "no device"; adb shell input text "$(printf '%s' "$*" | sed 's/ /%s/g')"; ok "typed" ;;
    ios)     ios_input_note ;;
    macos)   macos_note ;;
    *) die "text <platform> \"...\"" ;;
  esac
}
ios_input_note() { die "live input on a physical iPhone needs a WebDriverAgent / in-app automation bridge — on the roadmap (docs/ROADMAP.md). screenshot + deploy + logs work today."; }
macos_note()     { die "live macOS input isn't wired yet; the htmlviewer accepts a --script of click/drag/key/wheel at launch (see examples/htmlviewer). An in-app bridge is on the roadmap."; }

# ---- usage -------------------------------------------------------------------
usage() {
  cat <<EOF
${B}tina4pascal${Z} — dev CLI for the Tina4Pascal native HTML renderer

${B}usage${Z}  tina4pascal <command> [args]

${B}toolchain${Z}
  doctor                 report FPC targets, Android SDK/NDK, adb, iOS, java
  setup [fpc|android|ios|all]  download + install missing toolchains

${B}build & test${Z}
  build <target|all>     compile ($ALL_TARGETS)
  test                   build + run all unit suites
  compliance [glob]      run the W3C reftest suite

${B}start an app${Z}
  new <name>             scaffold a starter app (app.html + main.pas)
  dev [dir]              build + run an app folder on macOS (default: .)

${B}macOS run${Z}
  macos [--run]          build the native macOS .app (same engine as mobile)
  run [page.html]        build + open the HTML viewer on a page
  snapshot <html> <png>  headless off-screen render to PNG

${B}deploy & run${Z}  (targets: android · ios · macos · win64 · linux)
  deploy <target>        build + install/open + launch on the target
  launch <target>        re-foreground the installed app, NO rebuild (fast run)
  ios                    (alias) build engine + xcodebuild sign + install + launch on iPhone
  apk                    Android: native .so (all ABIs) + signed debug APK

${B}release signing${Z}  (Android)
  keygen [out.jks] [alias]   create a release keystore (one-time; keep it safe)
  release                    build a release-SIGNED APK
                             (needs TINA4_KEYSTORE / TINA4_KEY_ALIAS / TINA4_KS_PASS)

${B}debug loop${Z}
  debug <target>         build → install → launch → screenshot → tail log
                         (android · ios · macos; win64/linux cross-compile only)

${B}drive the app${Z}  (the device-automation the IDE builds on)
  screenshot <target> [out.png]   grab the app screen  (android · ios · macos)
  tap <target> X Y                click/tap at screen coords
  swipe <target> X1 Y1 X2 Y2 [ms] scroll / drag
  text <target> "..."             type into the focused field
  logs <target> [-f|N]            on-device log: android = app pid (or crash),
                                  ios = CoreDevice syslog over the tunnel
                         (android: full live input; ios/macos: screenshot+deploy now,
                          live input via WebDriverAgent / in-app bridge — roadmap)

  clean                  remove build outputs
EOF
}

# ---- dispatch ----------------------------------------------------------------
cmd="${1:-help}"; [ $# -gt 0 ] && shift || true
case "$cmd" in
  doctor)     cmd_doctor "$@" ;;
  setup)      cmd_setup "$@" ;;
  init)       cmd_init "$@" ;;
  build)      if is_project; then build_project "$@"; else cmd_build "$@"; fi ;;
  test)       cmd_test "$@" ;;
  new)        cmd_new "$@" ;;
  dev)        cmd_dev "$@" ;;
  macos)      cmd_macos "$@" ;;
  run)        if is_project; then run_project "$@"; else cmd_run "$@"; fi ;;
  render)     if is_project; then render_project "$@"; else die "render: run inside a project dir"; fi ;;
  where)      if is_project; then where_project "$@"; else die "where: run inside a project dir"; fi ;;
  dom)        if is_project; then dump_project dom;         else die "dom: run inside a project dir"; fi ;;
  boxes)      if is_project; then dump_project boxes;       else die "boxes: run inside a project dir"; fi ;;
  inspect)    if is_project; then dump_project inspect "$@"; else die "inspect: run inside a project dir"; fi ;;
  snapshot)   cmd_snapshot "$@" ;;
  compliance) cmd_compliance "$@" ;;
  apk)        cmd_apk "$@" ;;
  keygen)     cmd_keygen "$@" ;;
  release)    cmd_release "$@" ;;
  deploy)     case "${1:-}" in android|ios|macos|win64|windows|linux) cmd_run_target "$@" ;; *) cmd_deploy "$@" ;; esac ;;
  ios)        cmd_ios "$@" ;;
  launch)     cmd_launch "$@" ;;
  debug)      if is_project; then debug_native "$@"; else cmd_debug "$@"; fi ;;
  script)     if is_project; then script_project "$@"; else die "script: run inside a project dir"; fi ;;
  screenshot) cmd_screenshot "$@" ;;
  tap)        cmd_tap "$@" ;;
  swipe)      cmd_swipe "$@" ;;
  text)       cmd_text "$@" ;;
  logs)       cmd_logs "$@" ;;
  logcat)     cmd_logcat "$@" ;;
  clean)      cmd_clean "$@" ;;
  help|-h|--help) usage ;;
  *) bad "unknown command: $cmd"; say ""; usage; exit 1 ;;
esac
