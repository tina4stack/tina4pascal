#!/bin/sh
# tina4pascal — developer CLI for the Tina4Pascal native HTML renderer.
#
#   tina4pascal <command> [args]
#
# One entry point to check the toolchain, DOWNLOAD what's missing, and build /
# test / run / package for every target from this Mac. Pure POSIX sh.
set -eu

# ---- locations ---------------------------------------------------------------
SELF="$(cd "$(dirname "$0")" && pwd)"
ROOT="$(cd "$SELF/.." && pwd)"
SRC="$ROOT/src"
BUILD="$ROOT/build"

FPC_HOME="${FPC_HOME:-$HOME/fpc}"
FPC="$FPC_HOME/bin/fpc"
export PPC_CONFIG_PATH="${PPC_CONFIG_PATH:-$FPC_HOME/etc}"

# Android SDK / NDK (brew-cask defaults; override with env)
ANDROID_SDK="${ANDROID_SDK:-${ANDROID_HOME:-/opt/homebrew/share/android-commandlinetools}}"
ANDROID_NDK="${ANDROID_NDK:-/opt/homebrew/share/android-ndk}"
BT_VER="34.0.0"; PLATFORM_VER="android-34"

# iOS (physical device via Xcode + libimobiledevice/pymobiledevice3)
IOS_DIR="$ROOT/ios"
IOS_BUNDLE="com.tina4.pascal"
ANDROID_PKG="com.tina4.pascal"      # Android application id (adb targets)
# pipx installs pymobiledevice3 here; fall back to PATH
PMD3="$(command -v pymobiledevice3 2>/dev/null || echo "$HOME/.local/bin/pymobiledevice3")"

# ---- pretty ------------------------------------------------------------------
if [ -t 1 ]; then B="$(printf '\033[1m')"; D="$(printf '\033[2m')"; G="$(printf '\033[32m')"; Y="$(printf '\033[33m')"; R="$(printf '\033[31m')"; Z="$(printf '\033[0m')"; else B=; D=; G=; Y=; R=; Z=; fi
say()  { printf '%s\n' "$*"; }
ok()   { printf '%s✓%s %s\n' "$G" "$Z" "$*"; }
warn() { printf '%s!%s %s\n' "$Y" "$Z" "$*"; }
bad()  { printf '%s✗%s %s\n' "$R" "$Z" "$*"; }
die()  { bad "$*"; exit 1; }

# ---- target compiler flags ---------------------------------------------------
# echoes the FPC flags for a target name, or nothing if unknown
target_flags() {
  case "$1" in
    macos|darwin)   echo "" ;;
    windows|win64)  echo "-Twin64 -Px86_64" ;;
    linux|linux64)  echo "-Tlinux -Px86_64" ;;
    linux-arm64)    echo "-Tlinux -Paarch64" ;;
    android)        echo "-Tandroid -Paarch64" ;;
    ios)            echo "-Tios -Paarch64" ;;
    *) return 1 ;;
  esac
}
ALL_TARGETS="macos windows linux linux-arm64 android ios"

need_fpc() { [ -x "$FPC" ] || die "FPC not found at $FPC — run: tina4pascal setup fpc"; }

# ---- doctor ------------------------------------------------------------------
cmd_doctor() {
  say "${B}Tina4Pascal toolchain${Z}   ${D}$ROOT${Z}"
  say ""
  say "${B}Free Pascal${Z}"
  if [ -x "$FPC" ]; then
    ok "fpc  $("$FPC" -iV 2>/dev/null)   ${D}$FPC${Z}"
    for t in $ALL_TARGETS; do
      f="$(target_flags "$t")"
      if echo | "$FPC" $f -iTP >/dev/null 2>&1; then ok "  target $t"; else warn "  target $t (cross RTL missing)"; fi
    done
  else
    bad "fpc missing → tina4pascal setup fpc"
  fi
  say ""
  say "${B}Android${Z}"
  [ -x "$ANDROID_SDK/build-tools/$BT_VER/aapt2" ] && ok "build-tools $BT_VER" || warn "SDK build-tools missing → tina4pascal setup android"
  [ -f "$ANDROID_SDK/platforms/$PLATFORM_VER/android.jar" ] && ok "platform $PLATFORM_VER" || warn "SDK platform missing → tina4pascal setup android"
  [ -e "$ANDROID_NDK/toolchains" ] && ok "NDK  ${D}$ANDROID_NDK${Z}" || warn "NDK missing → tina4pascal setup android"
  if command -v adb >/dev/null 2>&1; then
    n="$(adb devices 2>/dev/null | grep -cw device || true)"
    [ "${n:-0}" -gt 0 ] && ok "adb — $n device(s) attached" || warn "adb — no devices attached"
  else warn "adb not on PATH"; fi
  say ""
  say "${B}iOS${Z}"
  command -v xcodebuild >/dev/null 2>&1 && ok "$(xcodebuild -version 2>/dev/null | head -1)" || warn "Xcode missing → install from the App Store"
  command -v xcodegen >/dev/null 2>&1 && ok "xcodegen" || warn "xcodegen missing → tina4pascal setup ios"
  u="$(ios_udid)"
  [ -n "$u" ] && ok "device ${D}$u${Z}" || warn "no iOS device attached (idevice_id / devicectl)"
  { [ -x "$PMD3" ] || command -v pymobiledevice3 >/dev/null 2>&1; } && ok "pymobiledevice3 (device screenshots)" || warn "pymobiledevice3 missing → tina4pascal setup ios"
  say ""
  say "${B}Java${Z}"
  command -v java >/dev/null 2>&1 && ok "$(java -version 2>&1 | head -1)" || warn "java missing (needed to package APKs)"
}

# ---- setup (downloads) -------------------------------------------------------
cmd_setup() {
  what="${1:-all}"
  case "$what" in
    fpc)     setup_fpc ;;
    android) setup_android ;;
    ios)     setup_ios ;;
    all)     setup_fpc; setup_android; setup_ios ;;
    *) die "setup: unknown component '$what' (fpc | android | ios | all)" ;;
  esac
}

# iOS build + on-device debug tooling. Xcode itself is a manual install; this
# grabs the pieces the CLI drives: xcodegen (project generation) and
# libimobiledevice + pymobiledevice3 (device list, install, and the iOS 17+
# screenshot over the native tunnel).
setup_ios() {
  command -v brew >/dev/null 2>&1 || die "Homebrew required to fetch the iOS tooling"
  command -v xcodebuild >/dev/null 2>&1 || warn "Xcode not found — install it from the App Store (needed to build/sign the app)"
  command -v xcodegen >/dev/null 2>&1 || { say "→ installing xcodegen…"; brew install xcodegen; }
  command -v idevice_id >/dev/null 2>&1 || { say "→ installing libimobiledevice…"; brew install libimobiledevice; }
  if [ ! -x "$PMD3" ] && ! command -v pymobiledevice3 >/dev/null 2>&1; then
    command -v pipx >/dev/null 2>&1 || { say "→ installing pipx…"; brew install pipx; }
    say "→ installing pymobiledevice3 (iOS 17+ device screenshots)…"
    pipx install pymobiledevice3
  fi
  PMD3="$(command -v pymobiledevice3 2>/dev/null || echo "$HOME/.local/bin/pymobiledevice3")"
  ok "iOS tooling ready"
}

setup_fpc() {
  if [ -x "$FPC" ]; then ok "FPC already at $FPC_HOME"; return; fi
  warn "FPC + cross-compilers are built from source (20+ pitfalls solved once)."
  say  "  Follow docs/TOOLCHAIN.md, or run the formula:"
  say  "    sh $ROOT/toolchain/build-crosses.sh"
  say  "  (Homebrew's fpc is native-only — no cross RTLs — so it won't do.)"
}

setup_android() {
  command -v brew >/dev/null 2>&1 || die "Homebrew required to fetch the Android toolchain"
  if [ ! -x "$ANDROID_SDK/cmdline-tools/latest/bin/sdkmanager" ] && ! command -v sdkmanager >/dev/null 2>&1; then
    say "→ installing Android command-line tools…"
    brew install --cask android-commandlinetools
  fi
  if [ ! -e "$ANDROID_NDK/toolchains" ]; then
    say "→ installing Android NDK…"
    brew install --cask android-ndk
  fi
  SM="$ANDROID_SDK/cmdline-tools/latest/bin/sdkmanager"
  [ -x "$SM" ] || SM="$(command -v sdkmanager)"
  JAVA_HOME="${JAVA_HOME:-$(/usr/libexec/java_home 2>/dev/null || true)}"; export JAVA_HOME
  say "→ accepting licenses + installing platform/build-tools…"
  yes | "$SM" --licenses >/dev/null 2>&1 || true
  "$SM" "platforms;$PLATFORM_VER" "build-tools;$BT_VER" "platform-tools" >/dev/null
  ok "Android toolchain ready"
  cmd_doctor | sed -n '/Android/,/Java/p'
}

# ---- build -------------------------------------------------------------------
# build a Pascal program for a target into build/<target>/
build_prog() {
  target="$1"; prog="$2"
  flags="$(target_flags "$target")" || die "unknown target '$target'"
  need_fpc
  outdir="$BUILD/$target"; mkdir -p "$outdir"
  say "${D}fpc $flags $(basename "$prog")${Z}"
  "$FPC" -Mdelphi -O2 -Xs $flags -Fu"$SRC" -FE"$outdir" -FU"$outdir" "$prog" 2>&1 \
    | grep -Ei "error|fatal" && die "build failed" || true
}

cmd_build() {
  target="${1:-macos}"
  case "$target" in
    macos)
      build_prog macos "$ROOT/examples/htmlviewer/htmlviewer.pas"
      ok "macOS viewer → $BUILD/macos/htmlviewer" ;;
    android)
      sh "$ROOT/android/build.sh" ;;
    windows|linux|linux-arm64|ios)
      # no GUI shell for these yet — compile the core test as a link smoke test
      build_prog "$target" "$ROOT/tests/test_dom.pas"
      ok "$target core builds (headless smoke test)" ;;
    all)
      for t in $ALL_TARGETS; do say "${B}— $t —${Z}"; cmd_build "$t"; done ;;
    *) die "build: unknown target '$target' ($ALL_TARGETS | all)" ;;
  esac
}

# ---- projects: init / project-aware build & run -----------------------------
is_project() { [ -f "$PWD/tina4.json" ]; }
default_host_target() {
  case "$(uname -s)" in Darwin) echo macos ;; Linux) echo linux ;; *) echo linux ;; esac
}

# build the current project's native app for a target into build/<target>/<name>
build_project() {
  target="${1:-$(default_host_target)}"
  is_project || die "not a Tina4Pascal project (no tina4.json)"
  if [ "$target" = "all" ]; then
    # every desktop/mobile target the toolchain can reach; skip the ones it can't
    for t in macos windows linux linux-arm64 android ios; do
      say "${B}— $t —${Z}"
      ( build_project "$t" ) || bad "$t skipped (cross toolchain not installed for this target)"
    done
    return
  fi
  name="$(basename "$PWD")"
  flags="$(target_flags "$target")" || die "unknown target '$target'"
  need_fpc
  out="$PWD/build/$target"; mkdir -p "$out"
  extra=""
  case "$target" in
    linux|linux-arm64)
      # make -lX11 resolvable without libx11-dev
      if [ ! -e /usr/lib/x86_64-linux-gnu/libX11.so ] && [ -e /usr/lib/x86_64-linux-gnu/libX11.so.6 ]; then
        mkdir -p "$HOME/.tina4/xstub"
        ln -sf /usr/lib/x86_64-linux-gnu/libX11.so.6 "$HOME/.tina4/xstub/libX11.so"
        extra="-Fl$HOME/.tina4/xstub -k-L$HOME/.tina4/xstub"
      fi ;;
  esac
  say "${D}fpc $flags src/app/main.pas${Z}"
  "$FPC" -Mdelphi -O2 -Xs $flags -Fu"$SRC" -Fusrc/app -Fusrc/routes $extra \
    -FE"$out" -FU"$out" -o"$name" src/app/main.pas 2>&1 | grep -Ei "error|fatal" && die "build failed" || true
  ok "$name ($target) -> build/$target/$name"
}

run_project() {
  target="${1:-$(default_host_target)}"
  build_project "$target"
  name="$(basename "$PWD")"
  say "→ running build/$target/$name"
  ( exec "$PWD/build/$target/$name" )
}

# build + render one frame headless to an image (so an AI/CI can 'see' it).
# NB: build_project clobbers the shell-global $out/$target/$name (POSIX sh has no
# local scope here), so capture our own values into distinct names first.
render_project() {
  rtarget="${1:-$(default_host_target)}"; rout="${2:-shot}"; rw="${3:-900}"; rh="${4:-640}"
  build_project "$rtarget"
  rname="$(basename "$PWD")"
  case "$rout" in *.*) : ;; *) case "$rtarget" in linux*) rout="$rout.bmp" ;; *) rout="$rout.png" ;; esac ;; esac
  rexe="$PWD/build/$rtarget/$rname"
  # The X11 app needs a display. On a headless server (no DISPLAY) fall back to
  # Xvfb so `render linux` still works in CI/agents; macOS/Windows render headless.
  rneedx=0; case "$rtarget" in linux*) [ -z "${DISPLAY:-}" ] && rneedx=1 ;; esac
  if [ "$rneedx" -eq 1 ]; then
    if command -v xvfb-run >/dev/null 2>&1; then
      say "${D}no DISPLAY — rendering under xvfb-run${Z}"
      xvfb-run -a -s "-screen 0 ${rw}x${rh}x24" "$rexe" --snapshot "$rout" --width "$rw" --height "$rh" >/dev/null 2>&1 || true
    elif command -v Xvfb >/dev/null 2>&1; then
      say "${D}no DISPLAY — starting Xvfb :99${Z}"
      Xvfb :99 -screen 0 "${rw}x${rh}x24" >/dev/null 2>&1 & xvpid=$!
      sleep 1
      DISPLAY=:99 "$rexe" --snapshot "$rout" --width "$rw" --height "$rh" >/dev/null 2>&1 || true
      kill "$xvpid" >/dev/null 2>&1 || true
    else
      bad "no DISPLAY and no Xvfb — install it (Debian/Ubuntu: 'sudo apt install xvfb'; Fedora: 'dnf install xorg-x11-server-Xvfb') or set DISPLAY"; return 1
    fi
  else
    "$rexe" --snapshot "$rout" --width "$rw" --height "$rh" >/dev/null 2>&1 || true
  fi
  if [ -f "$rout" ]; then ok "rendered $rout"; echo "$rout"
  else bad "no snapshot produced"; fi
}
where_project() { echo "$PWD/build/${1:-$(default_host_target)}/$(basename "$PWD")"; }

# scaffold a full Tina4-backend-style project, then build + run it
cmd_init() {
  name=""; norun=0
  for a in "$@"; do case "$a" in --no-run) norun=1 ;; *) [ -z "$name" ] && name="$a" ;; esac; done
  [ -n "$name" ] || die "usage: tina4pascal init <name> [--no-run]"
  [ -e "$name" ] && die "'$name' already exists"
  need_fpc
  title="$(printf '%s' "$name" | awk '{print toupper(substr($0,1,1)) substr($0,2)}')"
  d="$name"
  mkdir -p "$d/migrations" "$d/assets" "$d/src/app" "$d/src/routes" "$d/src/orm" "$d/src/services" "$d/src/templates"

  cat > "$d/tina4.json" <<EOF
{
  "name": "$name",
  "title": "$title",
  "bundleId": "com.tina4.$name",
  "window": { "width": 900, "height": 640 },
  "entry": "src/templates/index.twig",
  "targets": ["macos", "linux", "win64", "android", "ios"]
}
EOF
  printf 'build/\n*.o\n*.ppu\n*.exe\n' > "$d/.gitignore"
  printf '# %s\n\nA Tina4Pascal native app. `tina4pascal run` builds and launches it.\n' "$title" > "$d/README.md"
  printf -- '-- 0001_init: first migration\n-- CREATE TABLE example (id INTEGER PRIMARY KEY, name TEXT);\n' > "$d/migrations/0001_init.sql"
  : > "$d/src/orm/.gitkeep"; : > "$d/src/services/.gitkeep"
  cat > "$d/src/routes/home.pas" <<'EOF'
unit home;
{ Route handlers for semantic events, e.g. onclick="Home:hello". }
{$mode objfpc}{$H+}
interface
implementation
end.
EOF
  cat > "$d/src/templates/layout.twig" <<'EOF'
<body style="margin:0;font-family:Helvetica,Segoe UI,sans-serif;background:#fbfaf7">
  {% block content %}{% endblock %}
</body>
EOF
  cat > "$d/src/templates/index.twig" <<'EOF'
<body style="margin:0;font-family:Helvetica,Segoe UI,sans-serif;background:#fbfaf7;text-align:center;padding-top:140px">
  <img src="assets/icon.png" width="96" height="96" style="border-radius:22px">
  <h1 style="color:#2b41e6;margin:18px 0 4px;font-size:34px">Hello {{ name }}!</h1>
  <p style="color:#5b5c78;margin:0">Your Tina4Pascal app is running natively.</p>
</body>
EOF
  cat > "$d/src/app/main.pas" <<EOF
program $name;
{\$mode objfpc}{\$H+}
uses Tina4App;
begin
  RunApp('$title', 'src/templates', 'index.twig', '{"name":"World"}', 'assets/icon.png', 900, 640);
end.
EOF
  [ -f "$ROOT/branding/icon.png" ] && cp "$ROOT/branding/icon.png" "$d/assets/icon.png"
  ok "scaffolded ${B}$d/${Z}"
  if [ "$norun" -eq 1 ]; then
    ( cd "$d" && build_project "$(default_host_target)" )   # scaffold + build, no window (AI/MCP)
  else
    ( cd "$d" && run_project "$(default_host_target)" )
  fi
}

# ---- test / run / snapshot / compliance -------------------------------------
cmd_test() {
  need_fpc
  fail=0
  for t in dom qr svg picture services http docs frond pseudo media; do
    [ -f "$ROOT/tests/test_$t.pas" ] || continue
    o="$BUILD/test/$t"; mkdir -p "$o"
    "$FPC" -Mdelphi -Fu"$SRC" -FE"$o" -FU"$o" "$ROOT/tests/test_$t.pas" >/dev/null 2>&1 \
      || { bad "test_$t build failed"; fail=1; continue; }
    if "$o/test_$t" >/dev/null 2>&1; then ok "test_$t"; else bad "test_$t FAILED"; fail=1; fi
  done
  [ "$fail" -eq 0 ] && ok "all suites pass" || die "some suites failed"
}

cmd_run() {
  cmd_build macos
  page="${1:-$ROOT/examples/pages/bootstrap_test.html}"
  say "→ $page"
  ( cd "$ROOT/examples/htmlviewer" && exec "$BUILD/macos/htmlviewer" "$page" )
}

# build the native macOS app (Cocoa shell + shared engine) into a .app bundle
cmd_macos() {
  need_fpc
  o="$BUILD/macos-app"; mkdir -p "$o"
  say "${D}fpc examples/macos/main.pas${Z}"
  "$FPC" -Mdelphi -O2 -Xs -Fu"$SRC" -FE"$o" -FU"$o" -o"$o/Tina4Pascal" \
    "$ROOT/examples/macos/main.pas" 2>&1 | grep -Ei "error|fatal" && die "build failed" || true
  app="$BUILD/Tina4Pascal.app"; rm -rf "$app"
  mkdir -p "$app/Contents/MacOS" "$app/Contents/Resources"
  cp "$o/Tina4Pascal" "$app/Contents/MacOS/Tina4Pascal"
  cp "$ROOT/examples/macos/controls.html" "$app/Contents/Resources/controls.html"
  [ -f "$ROOT/branding/AppIcon.icns" ] && cp "$ROOT/branding/AppIcon.icns" "$app/Contents/Resources/AppIcon.icns"
  cat > "$app/Contents/Info.plist" <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>CFBundleExecutable</key><string>Tina4Pascal</string>
  <key>CFBundleIdentifier</key><string>com.tina4.pascal</string>
  <key>CFBundleName</key><string>Tina4Pascal</string>
  <key>CFBundleIconFile</key><string>AppIcon</string>
  <key>CFBundlePackageType</key><string>APPL</string>
  <key>CFBundleShortVersionString</key><string>1.0</string>
  <key>NSHighResolutionCapable</key><true/>
  <key>LSMinimumSystemVersion</key><string>10.13</string>
</dict></plist>
PLIST
  ok "built ${B}$app${Z}"
  case "${1:-}" in
    --run|run|open) say "→ opening"; open "$app" ;;
    *) say "  open it:  ${B}open $app${Z}   (or: tina4pascal macos --run)" ;;
  esac
}

# scaffold a new starter app (HTML + a Pascal host with actions + localStore)
cmd_new() {
  name="${1:-}"; [ -n "$name" ] || die "usage: tina4pascal new <name>"
  [ -e "$name" ] && die "'$name' already exists"
  mkdir -p "$name"
  cp "$ROOT/examples/starter/app.html" "$name/app.html"
  sed "s/My Tina4 App/$name/" "$ROOT/examples/starter/main.pas" > "$name/main.pas"
  ok "created ${B}$name/${Z}  (app.html + main.pas)"
  say "  run it:  ${B}cd $name && tina4pascal dev${Z}"
}

# build + run an app folder's main.pas on macOS (edit app.html, re-run to see)
cmd_dev() {
  d="${1:-.}"; [ -f "$d/main.pas" ] || die "no main.pas in '$d' (scaffold one: tina4pascal new <name>)"
  need_fpc
  o="$BUILD/dev"; mkdir -p "$o"
  say "${D}fpc $(basename "$d")/main.pas${Z}"
  "$FPC" -Mdelphi -O2 -Xs -Fu"$SRC" -FE"$o" -FU"$o" -o"$o/app" "$d/main.pas" 2>&1 \
    | grep -Ei "error|fatal" && die "build failed" || true
  ( cd "$d" && exec "$o/app" )   # runs from the app folder (app.html + localStore)
}

cmd_snapshot() {
  [ $# -ge 2 ] || die "usage: tina4pascal snapshot <page.html> <out.png>"
  cmd_build macos
  ( cd "$(dirname "$1")" && "$BUILD/macos/htmlviewer" "$(basename "$1")" --snapshot "$2" )
  ok "wrote $2"
}

cmd_compliance() { sh "$ROOT/tools/run-compliance.sh" "${1:-*}"; }

# ---- android apk / deploy ----------------------------------------------------
cmd_apk() {
  sh "$ROOT/android/build.sh"
  ANDROID_SDK="$ANDROID_SDK" \
    TINA4_KEYSTORE="${TINA4_KEYSTORE:-}" TINA4_KEY_ALIAS="${TINA4_KEY_ALIAS:-}" \
    TINA4_KS_PASS="${TINA4_KS_PASS:-}" TINA4_KEY_PASS="${TINA4_KEY_PASS:-}" \
    sh "$ROOT/android/build-apk.sh"
}

# keygen [out.jks] [alias] — create a release signing keystore (prompts for the
# passwords + identity). One-time; keep the file + passwords safe (Play requires
# the SAME key for every update).
cmd_keygen() {
  ks="${1:-$ROOT/android/release.jks}"; alias="${2:-tina4}"
  command -v keytool >/dev/null 2>&1 || die "keytool not found (install a JDK)"
  [ -f "$ks" ] && die "keystore already exists: $ks (delete it to regenerate)"
  say "→ creating release keystore ${D}$ks${Z} (alias $alias)"
  keytool -genkeypair -v -keystore "$ks" -alias "$alias" \
    -keyalg RSA -keysize 2048 -validity 10000 || die "keytool failed"
  ok "keystore created: $ks"
  say "To sign a release build, export these (then: tina4pascal release):"
  say "  export TINA4_KEYSTORE=\"$ks\""
  say "  export TINA4_KEY_ALIAS=\"$alias\""
  say "  export TINA4_KS_PASS=…   # store password you just set"
  say "  export TINA4_KEY_PASS=…  # key password (omit if same as store)"
}

# release — build a release-SIGNED APK (needs the TINA4_KEYSTORE env, see keygen)
cmd_release() {
  [ -n "${TINA4_KEYSTORE:-}" ] \
    || die "no release keystore — run: tina4pascal keygen, then export TINA4_KEYSTORE/TINA4_KEY_ALIAS/TINA4_KS_PASS"
  cmd_apk
  ok "release APK → $ROOT/android/tina4pascal-release.apk"
}

cmd_deploy() {
  command -v adb >/dev/null 2>&1 || die "adb not found"
  [ "$(adb devices | grep -cw device)" -gt 0 ] || die "no device attached (adb devices)"
  cmd_apk
  say "→ installing…"
  adb install -r "$ROOT/android/tina4pascal-debug.apk"
  adb shell am start -n com.tina4.pascal/.MainActivity
  ok "launched on device"
}

# ---- iOS build / deploy ------------------------------------------------------
# The device identifier for install/launch/screenshot. Everything goes through
# `xcrun devicectl` (CoreDevice, iOS 17+), so prefer the devicectl identifier of
# the first available iPhone/iPad; fall back to a USB idevice_id UDID.
ios_udid() {
  [ -n "${IOS_UDID:-}" ] && { echo "$IOS_UDID"; return; }
  id="$(xcrun devicectl list devices 2>/dev/null \
        | grep -iE 'available' | grep -iE 'iphone|ipad' \
        | grep -oE '[0-9A-Fa-f]{8}-([0-9A-Fa-f]{4}-){3}[0-9A-Fa-f]{12}' | head -1)"
  [ -n "$id" ] && { echo "$id"; return; }
  idevice_id -l 2>/dev/null | head -1
}

# static lib (Pascal engine) → xcodegen project → xcodebuild → install + launch
cmd_ios() {
  command -v xcodebuild >/dev/null 2>&1 || die "Xcode not found — run: tina4pascal setup ios"
  udid="$(ios_udid)"; [ -n "$udid" ] || die "no iOS device attached (idevice_id -l)"
  say "→ building the Pascal engine (libtina4ios.a)…"
  sh "$IOS_DIR/build.sh" >/dev/null 2>&1 || die "engine build failed (run ios/build.sh to see errors)"
  if [ ! -d "$IOS_DIR/Tina4Pascal.xcodeproj" ]; then
    command -v xcodegen >/dev/null 2>&1 || die "xcodegen not found — run: tina4pascal setup ios"
    ( cd "$IOS_DIR" && xcodegen >/dev/null )
  fi
  say "→ xcodebuild (sign for device)…"
  xcodebuild -project "$IOS_DIR/Tina4Pascal.xcodeproj" -scheme Tina4Pascal \
    -destination "generic/platform=iOS" -allowProvisioningUpdates build 2>&1 \
    | grep -qE "BUILD SUCCEEDED" || die "xcodebuild failed (open the project in Xcode to set your team)"
  app="$(xcodebuild -project "$IOS_DIR/Tina4Pascal.xcodeproj" -scheme Tina4Pascal \
    -destination "generic/platform=iOS" -showBuildSettings 2>/dev/null \
    | awk -F' = ' '/ TARGET_BUILD_DIR /{d=$2} / FULL_PRODUCT_NAME /{n=$2} END{print d"/"n}')"
  say "→ installing on $udid…"
  xcrun devicectl device install app --device "$udid" "$app" >/dev/null 2>&1 \
    || die "install failed (is the iPhone unlocked?)"
  xcrun devicectl device process launch --device "$udid" "$IOS_BUNDLE" >/dev/null 2>&1 || true
  ok "launched on device"
}

# launch <target>  — bring the already-installed app to the foreground, no build.
# (The IDE needs a fast "run" that skips the rebuild; also used to re-foreground
#  the app before a screenshot.)
cmd_launch() {
  plat="${1:-ios}"
  case "$plat" in
    ios)
      udid="$(ios_udid)"; [ -n "$udid" ] || die "no iOS device attached (idevice_id / devicectl)"
      xcrun devicectl device process launch --terminate-existing --device "$udid" "$IOS_BUNDLE" >/dev/null 2>&1 \
        || die "launch failed (installed? iPhone unlocked?)"
      ok "launched $IOS_BUNDLE on device" ;;
    android)
      adb shell monkey -p "$ANDROID_PKG" -c android.intent.category.LAUNCHER 1 >/dev/null 2>&1 \
        && ok "launched $ANDROID_PKG" || die "launch failed (installed? emulator/device up?)" ;;
    macos)
      open "$ROOT/examples/htmlviewer/htmlviewer" 2>/dev/null && ok "launched macOS viewer" || die "build macos first" ;;
    *) die "launch: unsupported target '$plat' (ios|android|macos)" ;;
  esac
}

cmd_clean() { rm -rf "$BUILD" "$ROOT/android/out" "$ROOT/android/tina4pascal-debug.apk" "$IOS_DIR/build" "$IOS_DIR/app/libtina4ios.a"; ok "cleaned"; }

# ---- device screenshot / logs / debug loop ----------------------------------
adb_have_device() { [ "$(adb devices | grep -cw device)" -gt 0 ]; }

# screenshot [android|ios|macos] [out.png]   — grab the app screen for a target.
# (legacy order `screenshot out.png platform` still accepted)
cmd_screenshot() {
  a1="${1:-android}"; a2="${2:-}"
  case "$a1" in
    android|ios|macos|win64|windows|linux) plat="$a1"; out="${a2:-$ROOT/build/$a1.png}" ;;
    *) out="$a1"; plat="${a2:-android}" ;;    # legacy: out first
  esac
  mkdir -p "$(dirname "$out")"
  case "$plat" in
    ios)
      [ -x "$PMD3" ] || command -v pymobiledevice3 >/dev/null 2>&1 || die "pymobiledevice3 missing — run: tina4pascal setup ios"
      # pymobiledevice3 opens the iOS 17+ native tunnel itself; the phone must
      # be unlocked. No app focus needed — it grabs the whole screen.
      "$PMD3" developer dvt screenshot "$out" >/dev/null 2>&1 || die "iOS screenshot failed (unlock the iPhone?)"
      ok "iOS screenshot → $out" ;;
    macos)
      # bring the running app forward, then capture its window (no shadow, PNG)
      osascript -e 'tell application "Tina4Pascal" to activate' >/dev/null 2>&1 || \
        open "$BUILD/Tina4Pascal.app" >/dev/null 2>&1 || true
      sleep 1
      wid="$(GetWindowID Tina4Pascal --list 2>/dev/null | awk 'NR==1{print $1}')"
      if [ -n "$wid" ]; then screencapture -o -x -l"$wid" "$out"
      else screencapture -o -x "$out"; fi          # fall back to full screen
      ok "macOS screenshot → $out" ;;
    win64|windows|linux)
      die "no $plat screenshot yet — the $plat windowed shell is pending (see docs/ROADMAP.md); 'build $plat' cross-compiles the engine" ;;
    android|*)
      adb_have_device || die "no device attached (adb devices)"
      adb shell input keyevent KEYCODE_WAKEUP >/dev/null 2>&1 || true   # slept screen = black
      adb shell am start -n com.tina4.pascal/.MainActivity >/dev/null 2>&1 || true
      sleep 1
      adb exec-out screencap -p > "$out"
      ok "screenshot → $out" ;;
  esac
}

# on-device log tail: logcat [android|ios] [-f|N]
cmd_logs() {
  plat="${1:-android}"; shift 2>/dev/null || true
  case "$plat" in
    ios)
      # CoreDevice (iOS 17+) syslog over the tunnel — same transport as the
      # screenshots; idevicesyslog needs USB libimobiledevice and won't see a
      # network-paired phone. Filter to the app + its media stack.
      PMD3="$(command -v pymobiledevice3 2>/dev/null || echo "$HOME/.local/bin/pymobiledevice3")"
      { [ -x "$PMD3" ] || command -v pymobiledevice3 >/dev/null 2>&1; } \
        || die "pymobiledevice3 missing — run: tina4pascal setup ios"
      filt='Tina4Pascal|tina4|AVPlayer|CoreMedia|VideoToolbox'
      case "${1:-}" in
        -f|--follow) "$PMD3" syslog live 2>/dev/null | grep --line-buffered -iE "$filt" ;;
        *) tmp="$(mktemp)"
           "$PMD3" syslog live 2>/dev/null | grep --line-buffered -iE "$filt" > "$tmp" & p=$!
           sleep "${1:-5}"; kill "$p" 2>/dev/null || true
           tail -"${2:-60}" "$tmp"; rm -f "$tmp" ;;
      esac ;;
    android|*) cmd_logcat "$@" ;;
  esac
}

# Android logs. Filters to the app's own process when it's running; if it isn't
# (e.g. it just crashed), falls back to the crash channels so a FATAL EXCEPTION
# is never hidden by a too-narrow tag filter.
cmd_logcat() {
  adb_have_device || die "no device attached"
  pid="$(adb shell pidof "$ANDROID_PKG" 2>/dev/null | tr -d '\r ' | awk '{print $1}')"
  case "${1:-}" in
    -f|--follow)
      if [ -n "$pid" ]; then adb logcat --pid="$pid"
      else adb logcat -s AndroidRuntime:* DEBUG:* tina4:* ; fi ;;
    *)
      if [ -n "$pid" ]; then adb logcat -d --pid="$pid" | tail -"${1:-60}"
      else
        warn "$ANDROID_PKG not running — showing recent crashes"
        adb logcat -d -s AndroidRuntime:* DEBUG:* tina4:* | tail -"${1:-60}"
      fi ;;
  esac
}

# deploy [android|ios|macos]  — build + install/open + launch on that target.
cmd_run_target() {
  case "${1:-android}" in
    ios)   cmd_ios ;;
    macos) cmd_macos --run ;;
    android) cmd_deploy ;;
    win64|windows|linux) cmd_build "$1"; warn "$1 windowed shell is pending — engine cross-compiled only (docs/ROADMAP.md)" ;;
    *) die "deploy <android|ios|macos|win64|linux>" ;;
  esac
}

# debug [android|ios|macos] — build → install → launch → screenshot → tail log.
cmd_debug() {
  plat="${1:-android}"
  case "$plat" in
    android)
      adb_have_device || die "no device attached"
      cmd_apk
      adb install -r "$ROOT/android/tina4pascal-debug.apk" >/dev/null
      adb logcat -c || true
      adb shell am force-stop com.tina4.pascal >/dev/null 2>&1 || true
      adb shell input keyevent KEYCODE_WAKEUP >/dev/null 2>&1 || true
      adb shell am start -n com.tina4.pascal/.MainActivity >/dev/null 2>&1
      sleep 3
      cmd_screenshot android "$ROOT/build/device.png"
      say "${B}--- device log (app pid, or crashes if it died) ---${Z}"
      cmd_logcat 40 ;;
    ios)
      cmd_ios
      sleep 2
      cmd_screenshot ios "$ROOT/build/ios.png"
      cmd_logs ios ;;
    macos)
      cmd_macos --run
      sleep 1
      cmd_screenshot macos "$ROOT/build/macos.png" ;;
    *) die "debug <android|ios|macos>" ;;
  esac
}

# ---- app input (drive the running app: navigate, click, type) ----------------
# tap <platform> X Y   — a click/tap at screen coords (device px)
cmd_tap() {
  plat="${1:-android}"; x="${2:-}"; y="${3:-}"
  [ -n "$x" ] && [ -n "$y" ] || die "usage: tina4pascal tap <android|ios|macos> X Y"
  case "$plat" in
    android) adb_have_device || die "no device"; adb shell input tap "$x" "$y"; ok "tap $x,$y" ;;
    ios)     ios_input_note ;;
    macos)   macos_note ;;
    *) die "tap <android|ios|macos> X Y" ;;
  esac
}
# swipe <platform> X1 Y1 X2 Y2 [ms]  — scroll / drag
cmd_swipe() {
  plat="${1:-android}"; shift 2>/dev/null || true
  [ $# -ge 4 ] || die "usage: tina4pascal swipe <platform> X1 Y1 X2 Y2 [ms]"
  case "$plat" in
    android) adb_have_device || die "no device"; adb shell input swipe "$1" "$2" "$3" "$4" "${5:-300}"; ok "swipe" ;;
    ios)     ios_input_note ;;
    macos)   macos_note ;;
    *) die "swipe <platform> X1 Y1 X2 Y2 [ms]" ;;
  esac
}
# text <platform> "string"  — type into the focused field
cmd_text() {
  plat="${1:-android}"; shift 2>/dev/null || true
  [ $# -ge 1 ] || die "usage: tina4pascal text <platform> \"...\""
  case "$plat" in
    android) adb_have_device || die "no device"; adb shell input text "$(printf '%s' "$*" | sed 's/ /%s/g')"; ok "typed" ;;
    ios)     ios_input_note ;;
    macos)   macos_note ;;
    *) die "text <platform> \"...\"" ;;
  esac
}
ios_input_note() { die "live input on a physical iPhone needs a WebDriverAgent / in-app automation bridge — on the roadmap (docs/ROADMAP.md). screenshot + deploy + logs work today."; }
macos_note()     { die "live macOS input isn't wired yet; the htmlviewer accepts a --script of click/drag/key/wheel at launch (see examples/htmlviewer). An in-app bridge is on the roadmap."; }

# ---- usage -------------------------------------------------------------------
usage() {
  cat <<EOF
${B}tina4pascal${Z} — dev CLI for the Tina4Pascal native HTML renderer

${B}usage${Z}  tina4pascal <command> [args]

${B}toolchain${Z}
  doctor                 report FPC targets, Android SDK/NDK, adb, iOS, java
  setup [fpc|android|ios|all]  download + install missing toolchains

${B}build & test${Z}
  build <target|all>     compile ($ALL_TARGETS)
  test                   build + run all unit suites
  compliance [glob]      run the W3C reftest suite

${B}start an app${Z}
  new <name>             scaffold a starter app (app.html + main.pas)
  dev [dir]              build + run an app folder on macOS (default: .)

${B}macOS run${Z}
  macos [--run]          build the native macOS .app (same engine as mobile)
  run [page.html]        build + open the HTML viewer on a page
  snapshot <html> <png>  headless off-screen render to PNG

${B}deploy & run${Z}  (targets: android · ios · macos · win64 · linux)
  deploy <target>        build + install/open + launch on the target
  launch <target>        re-foreground the installed app, NO rebuild (fast run)
  ios                    (alias) build engine + xcodebuild sign + install + launch on iPhone
  apk                    Android: native .so (all ABIs) + signed debug APK

${B}release signing${Z}  (Android)
  keygen [out.jks] [alias]   create a release keystore (one-time; keep it safe)
  release                    build a release-SIGNED APK
                             (needs TINA4_KEYSTORE / TINA4_KEY_ALIAS / TINA4_KS_PASS)

${B}debug loop${Z}
  debug <target>         build → install → launch → screenshot → tail log
                         (android · ios · macos; win64/linux cross-compile only)

${B}drive the app${Z}  (the device-automation the IDE builds on)
  screenshot <target> [out.png]   grab the app screen  (android · ios · macos)
  tap <target> X Y                click/tap at screen coords
  swipe <target> X1 Y1 X2 Y2 [ms] scroll / drag
  text <target> "..."             type into the focused field
  logs <target> [-f|N]            on-device log: android = app pid (or crash),
                                  ios = CoreDevice syslog over the tunnel
                         (android: full live input; ios/macos: screenshot+deploy now,
                          live input via WebDriverAgent / in-app bridge — roadmap)

  clean                  remove build outputs
EOF
}

# ---- dispatch ----------------------------------------------------------------
cmd="${1:-help}"; [ $# -gt 0 ] && shift || true
case "$cmd" in
  doctor)     cmd_doctor "$@" ;;
  setup)      cmd_setup "$@" ;;
  init)       cmd_init "$@" ;;
  build)      if is_project; then build_project "$@"; else cmd_build "$@"; fi ;;
  test)       cmd_test "$@" ;;
  new)        cmd_new "$@" ;;
  dev)        cmd_dev "$@" ;;
  macos)      cmd_macos "$@" ;;
  run)        if is_project; then run_project "$@"; else cmd_run "$@"; fi ;;
  render)     if is_project; then render_project "$@"; else die "render: run inside a project dir"; fi ;;
  where)      if is_project; then where_project "$@"; else die "where: run inside a project dir"; fi ;;
  snapshot)   cmd_snapshot "$@" ;;
  compliance) cmd_compliance "$@" ;;
  apk)        cmd_apk "$@" ;;
  keygen)     cmd_keygen "$@" ;;
  release)    cmd_release "$@" ;;
  deploy)     case "${1:-}" in android|ios|macos|win64|windows|linux) cmd_run_target "$@" ;; *) cmd_deploy "$@" ;; esac ;;
  ios)        cmd_ios "$@" ;;
  launch)     cmd_launch "$@" ;;
  debug)      cmd_debug "$@" ;;
  screenshot) cmd_screenshot "$@" ;;
  tap)        cmd_tap "$@" ;;
  swipe)      cmd_swipe "$@" ;;
  text)       cmd_text "$@" ;;
  logs)       cmd_logs "$@" ;;
  logcat)     cmd_logcat "$@" ;;
  clean)      cmd_clean "$@" ;;
  help|-h|--help) usage ;;
  *) bad "unknown command: $cmd"; say ""; usage; exit 1 ;;
esac
