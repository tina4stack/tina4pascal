#!/bin/sh
# tina4pascal — developer CLI for the Tina4Pascal native HTML renderer.
#
#   tina4pascal <command> [args]
#
# One entry point to check the toolchain, DOWNLOAD what's missing, and build /
# test / run / package for every target from this Mac. Pure POSIX sh.
set -eu

# ---- locations ---------------------------------------------------------------
SELF="$(cd "$(dirname "$0")" && pwd)"
ROOT="$(cd "$SELF/.." && pwd)"
SRC="$ROOT/src"
BUILD="$ROOT/build"

# Per-machine toolchain cache: one place `setup` downloads everything into, shared
# by every project and never committed. A project pins tool VERSIONS (tina4.json);
# the CLI resolves the PATHS here so `git clone && tina4pascal setup && build` works
# on anyone's computer. Resolution order everywhere: explicit env → ~/.tina4 →
# common system locations. Override the root with TINA4_HOME.
TINA4_HOME="${TINA4_HOME:-$HOME/.tina4}"
TC="$TINA4_HOME/toolchains"
KEYSTORE_DIR="${TINA4_KEYSTORE_DIR:-$TINA4_HOME/keystores}"   # release signing (secrets)

# ---- minimal tina4.json reader (top-level "key": "value" / number) -----------
# Not a general JSON parser — just enough to read the flat config keys we own.
# jq is used when present (robust); otherwise a sed fallback. Comments (// ...)
# are tolerated so a scaffolded tina4.json can explain itself.
jget() { # jget <key> [default]  (reads ./tina4.json in $PWD)
  _k="$1"; _def="${2:-}"; _f="$PWD/tina4.json"; _v=""
  [ -f "$_f" ] || { printf '%s' "$_def"; return; }
  if command -v jq >/dev/null 2>&1; then
    _v="$(sed 's://.*$::' "$_f" | jq -r --arg k "$_k" '(.[$k] // empty) | if type=="object" or type=="array" then empty else . end' 2>/dev/null)"
  fi
  [ -z "$_v" ] && _v="$(sed 's://.*$::' "$_f" | grep -oE "\"$_k\"[[:space:]]*:[[:space:]]*\"[^\"]*\"" | head -1 | sed -E "s/.*:[[:space:]]*\"([^\"]*)\".*/\1/")"
  [ -z "$_v" ] && _v="$_def"
  printf '%s' "$_v"
}

# ---- FPC (env → ~/.tina4/toolchains/fpc → ~/fpc → PATH) ----------------------
_resolve_fpc_home() {
  [ -n "${FPC_HOME:-}" ] && { printf '%s' "$FPC_HOME"; return; }
  for c in "$TC/fpc" "$HOME/fpc"; do
    [ -x "$c/bin/fpc" ] && { printf '%s' "$c"; return; }
  done
  _p="$(command -v fpc 2>/dev/null)" && { printf '%s' "$(cd "$(dirname "$_p")/.." && pwd)"; return; }
  printf '%s' "$TC/fpc"       # where `setup fpc` will install it
}
FPC_HOME="$(_resolve_fpc_home)"
FPC="$FPC_HOME/bin/fpc"
[ -d "$FPC_HOME/etc" ] && export PPC_CONFIG_PATH="${PPC_CONFIG_PATH:-$FPC_HOME/etc}"

# ---- Android SDK / NDK (env → ~/.tina4 → common OS locations) ----------------
_resolve_android_sdk() {
  for c in "${ANDROID_SDK:-}" "${ANDROID_HOME:-}" "${ANDROID_SDK_ROOT:-}" \
           "$TC/android/sdk" "/opt/homebrew/share/android-commandlinetools" \
           "$HOME/Library/Android/sdk" "$HOME/Android/Sdk" \
           "${LOCALAPPDATA:-}/Android/Sdk"; do
    [ -n "$c" ] && [ -d "$c" ] && { printf '%s' "$c"; return; }
  done
  printf '%s' "$TC/android/sdk"   # where `setup android` will install it
}
ANDROID_SDK="$(_resolve_android_sdk)"
_resolve_android_ndk() {
  for c in "${ANDROID_NDK:-}" "${ANDROID_NDK_HOME:-}" "$TC/android/ndk" \
           "/opt/homebrew/share/android-ndk"; do
    [ -n "$c" ] && [ -e "$c/toolchains" ] && { printf '%s' "$c"; return; }
  done
  # a versioned ndk under the SDK (…/ndk/<ver>) — pick the highest
  if [ -d "$ANDROID_SDK/ndk" ]; then
    _n="$(ls -1 "$ANDROID_SDK/ndk" 2>/dev/null | sort -V | tail -1)"
    [ -n "$_n" ] && { printf '%s' "$ANDROID_SDK/ndk/$_n"; return; }
  fi
  printf '%s' "${ANDROID_NDK:-/opt/homebrew/share/android-ndk}"
}
ANDROID_NDK="$(_resolve_android_ndk)"
BT_VER="34.0.0"; PLATFORM_VER="android-34"

# iOS (physical device via Xcode + libimobiledevice/pymobiledevice3)
IOS_DIR="$ROOT/ios"
IOS_BUNDLE="com.tina4.pascal"
ANDROID_PKG="com.tina4.pascal"      # Android application id (adb targets)
# pipx installs pymobiledevice3 here; fall back to PATH
PMD3="$(command -v pymobiledevice3 2>/dev/null || echo "$HOME/.local/bin/pymobiledevice3")"

# ---- pretty ------------------------------------------------------------------
if [ -t 1 ]; then B="$(printf '\033[1m')"; D="$(printf '\033[2m')"; G="$(printf '\033[32m')"; Y="$(printf '\033[33m')"; R="$(printf '\033[31m')"; Z="$(printf '\033[0m')"; else B=; D=; G=; Y=; R=; Z=; fi
say()  { printf '%s\n' "$*"; }
ok()   { printf '%s✓%s %s\n' "$G" "$Z" "$*"; }
warn() { printf '%s!%s %s\n' "$Y" "$Z" "$*"; }
bad()  { printf '%s✗%s %s\n' "$R" "$Z" "$*"; }
die()  { bad "$*"; exit 1; }

# ---- target compiler flags ---------------------------------------------------
# echoes the FPC flags for a target name, or nothing if unknown
target_flags() {
  case "$1" in
    macos|darwin)   echo "" ;;
    windows|win64)  echo "-Twin64 -Px86_64" ;;
    linux|linux64)  echo "-Tlinux -Px86_64" ;;
    linux-arm64)    echo "-Tlinux -Paarch64" ;;
    android)        echo "-Tandroid -Paarch64" ;;
    ios)            echo "-Tios -Paarch64" ;;
    *) return 1 ;;
  esac
}
ALL_TARGETS="macos windows linux linux-arm64 android ios"

need_fpc() { [ -x "$FPC" ] || die "FPC not found at $FPC — run: tina4pascal setup fpc"; }

# ---- doctor ------------------------------------------------------------------
cmd_doctor() {
  say "${B}Tina4Pascal toolchain${Z}   ${D}$ROOT${Z}"
  say ""
  say "${B}Free Pascal${Z}"
  if [ -x "$FPC" ]; then
    ok "fpc  $("$FPC" -iV 2>/dev/null)   ${D}$FPC${Z}"
    for t in $ALL_TARGETS; do
      f="$(target_flags "$t")"
      if echo | "$FPC" $f -iTP >/dev/null 2>&1; then ok "  target $t"; else warn "  target $t (cross RTL missing)"; fi
    done
  else
    bad "fpc missing → tina4pascal setup fpc"
  fi
  command -v gdb >/dev/null 2>&1 && ok "gdb (native debug: tina4pascal debug)" \
    || warn "gdb missing → apt install gdb / brew install gdb (for tina4pascal debug)"
  say ""
  say "${B}Android${Z}"
  [ -x "$ANDROID_SDK/build-tools/$BT_VER/aapt2" ] && ok "build-tools $BT_VER" || warn "SDK build-tools missing → tina4pascal setup android"
  [ -f "$ANDROID_SDK/platforms/$PLATFORM_VER/android.jar" ] && ok "platform $PLATFORM_VER" || warn "SDK platform missing → tina4pascal setup android"
  [ -e "$ANDROID_NDK/toolchains" ] && ok "NDK  ${D}$ANDROID_NDK${Z}" || warn "NDK missing → tina4pascal setup android"
  if command -v adb >/dev/null 2>&1; then
    n="$(adb devices 2>/dev/null | grep -cw device || true)"
    [ "${n:-0}" -gt 0 ] && ok "adb — $n device(s) attached" || warn "adb — no devices attached"
  else warn "adb not on PATH"; fi
  say ""
  say "${B}iOS${Z}"
  command -v xcodebuild >/dev/null 2>&1 && ok "$(xcodebuild -version 2>/dev/null | head -1)" || warn "Xcode missing → install from the App Store"
  command -v xcodegen >/dev/null 2>&1 && ok "xcodegen" || warn "xcodegen missing → tina4pascal setup ios"
  u="$(ios_udid)"
  [ -n "$u" ] && ok "device ${D}$u${Z}" || warn "no iOS device attached (idevice_id / devicectl)"
  { [ -x "$PMD3" ] || command -v pymobiledevice3 >/dev/null 2>&1; } && ok "pymobiledevice3 (device screenshots)" || warn "pymobiledevice3 missing → tina4pascal setup ios"
  say ""
  say "${B}Java${Z}"
  command -v java >/dev/null 2>&1 && ok "$(java -version 2>&1 | head -1)" || warn "java missing (needed to package APKs)"
}

# ---- setup (downloads) -------------------------------------------------------
cmd_setup() {
  what="${1:-all}"
  case "$what" in
    fpc)     setup_fpc ;;
    android) setup_android ;;
    ios)     setup_ios ;;
    all)     setup_fpc; setup_android; setup_ios ;;
    *) die "setup: unknown component '$what' (fpc | android | ios | all)" ;;
  esac
}

# iOS build + on-device debug tooling. Xcode itself is a manual install; this
# grabs the pieces the CLI drives: xcodegen (project generation) and
# libimobiledevice + pymobiledevice3 (device list, install, and the iOS 17+
# screenshot over the native tunnel).
setup_ios() {
  command -v brew >/dev/null 2>&1 || die "Homebrew required to fetch the iOS tooling"
  command -v xcodebuild >/dev/null 2>&1 || warn "Xcode not found — install it from the App Store (needed to build/sign the app)"
  command -v xcodegen >/dev/null 2>&1 || { say "→ installing xcodegen…"; brew install xcodegen; }
  command -v idevice_id >/dev/null 2>&1 || { say "→ installing libimobiledevice…"; brew install libimobiledevice; }
  if [ ! -x "$PMD3" ] && ! command -v pymobiledevice3 >/dev/null 2>&1; then
    command -v pipx >/dev/null 2>&1 || { say "→ installing pipx…"; brew install pipx; }
    say "→ installing pymobiledevice3 (iOS 17+ device screenshots)…"
    pipx install pymobiledevice3
  fi
  PMD3="$(command -v pymobiledevice3 2>/dev/null || echo "$HOME/.local/bin/pymobiledevice3")"
  ok "iOS tooling ready"
}

setup_fpc() {
  if [ -x "$FPC" ]; then ok "FPC already at $FPC_HOME"; return; fi
  warn "FPC + cross-compilers are built from source (20+ pitfalls solved once)."
  say  "  Follow docs/TOOLCHAIN.md, or run the formula:"
  say  "    sh $ROOT/toolchain/build-crosses.sh"
  say  "  (Homebrew's fpc is native-only — no cross RTLs — so it won't do.)"
}

setup_android() {
  command -v brew >/dev/null 2>&1 || die "Homebrew required to fetch the Android toolchain"
  if [ ! -x "$ANDROID_SDK/cmdline-tools/latest/bin/sdkmanager" ] && ! command -v sdkmanager >/dev/null 2>&1; then
    say "→ installing Android command-line tools…"
    brew install --cask android-commandlinetools
  fi
  if [ ! -e "$ANDROID_NDK/toolchains" ]; then
    say "→ installing Android NDK…"
    brew install --cask android-ndk
  fi
  SM="$ANDROID_SDK/cmdline-tools/latest/bin/sdkmanager"
  [ -x "$SM" ] || SM="$(command -v sdkmanager)"
  JAVA_HOME="${JAVA_HOME:-$(/usr/libexec/java_home 2>/dev/null || true)}"; export JAVA_HOME
  say "→ accepting licenses + installing platform/build-tools…"
  yes | "$SM" --licenses >/dev/null 2>&1 || true
  "$SM" "platforms;$PLATFORM_VER" "build-tools;$BT_VER" "platform-tools" >/dev/null
  ok "Android toolchain ready"
  cmd_doctor | sed -n '/Android/,/Java/p'
}

# ---- build -------------------------------------------------------------------
# build a Pascal program for a target into build/<target>/
build_prog() {
  target="$1"; prog="$2"
  flags="$(target_flags "$target")" || die "unknown target '$target'"
  need_fpc
  outdir="$BUILD/$target"; mkdir -p "$outdir"
  say "${D}fpc $flags $(basename "$prog")${Z}"
  "$FPC" -Mdelphi -O2 -Xs $flags -Fu"$SRC" -FE"$outdir" -FU"$outdir" "$prog" 2>&1 \
    | grep -Ei "error|fatal" && die "build failed" || true
}

cmd_build() {
  target="${1:-macos}"
  case "$target" in
    macos)
      build_prog macos "$ROOT/examples/htmlviewer/htmlviewer.pas"
      ok "macOS viewer → $BUILD/macos/htmlviewer" ;;
    android)
      sh "$ROOT/android/build.sh" ;;
    windows|linux|linux-arm64|ios)
      # no GUI shell for these yet — compile the core test as a link smoke test
      build_prog "$target" "$ROOT/tests/test_dom.pas"
      ok "$target core builds (headless smoke test)" ;;
    all)
      for t in $ALL_TARGETS; do say "${B}— $t —${Z}"; cmd_build "$t"; done ;;
    *) die "build: unknown target '$target' ($ALL_TARGETS | all)" ;;
  esac
}

# ---- projects: init / project-aware build & run -----------------------------
is_project() { [ -f "$PWD/tina4.json" ]; }
default_host_target() {
  case "$(uname -s)" in Darwin) echo macos ;; Linux) echo linux ;; *) echo linux ;; esac
}

# build the current project's native app for a target into build/<target>/<name>.
# 2nd arg --debug → DWARF symbols, no optimise/strip, into build/<target>-debug/.
build_project() {
  target="${1:-$(default_host_target)}"; bpmode="${2:-}"
  is_project || die "not a Tina4Pascal project (no tina4.json)"
  if [ "$target" = "all" ]; then
    # every desktop/mobile target the toolchain can reach; skip the ones it can't
    for t in macos windows linux linux-arm64 android ios; do
      say "${B}— $t —${Z}"
      ( build_project "$t" ) || bad "$t skipped (cross toolchain not installed for this target)"
    done
    return
  fi
  name="$(jget name "$(basename "$PWD")")"
  # Entry point: configurable in tina4.json ("main"), defaults to app.pas at the
  # project root. Desktop targets compile it to an executable; android/ios go
  # through their own host build (a program's RunApp isn't the entry there).
  main="$(jget main app.pas)"
  [ -f "$PWD/$main" ] || die "entry point '$main' not found (set \"main\" in tina4.json)"
  case "$target" in
    android) build_project_android; return ;;
    ios)     build_project_ios; return ;;
  esac
  flags="$(target_flags "$target")" || die "unknown target '$target'"
  need_fpc
  if [ "$bpmode" = "--debug" ]; then
    opts="-gw -gl -O-"; bsub="$target-debug"     # DWARF line info, no optimise/strip
  else
    opts="-O2 -Xs"; bsub="$target"
  fi
  out="$PWD/build/$bsub"; mkdir -p "$out"
  extra=""
  case "$target" in
    linux|linux-arm64)
      # make -lX11 resolvable without libx11-dev
      if [ ! -e /usr/lib/x86_64-linux-gnu/libX11.so ] && [ -e /usr/lib/x86_64-linux-gnu/libX11.so.6 ]; then
        mkdir -p "$TINA4_HOME/xstub"
        ln -sf /usr/lib/x86_64-linux-gnu/libX11.so.6 "$TINA4_HOME/xstub/libX11.so"
        extra="-Fl$TINA4_HOME/xstub -k-L$TINA4_HOME/xstub"
      fi ;;
  esac
  say "${D}fpc $opts $flags $main${Z}"
  "$FPC" -Mdelphi $opts $flags -Fu"$SRC" -Fu. -Fusrc/routes -Fusrc/orm -Fusrc/services $extra \
    -FE"$out" -FU"$out" -o"$name" "$main" 2>&1 | grep -Ei "error|fatal" && die "build failed" || true
  ok "$name ($target${bpmode:+ debug}) -> build/$bsub/$name"
}

# Render the project's entry template (Twig, with {% include %}/{% extends %}
# resolved from src/templates) to a static HTML file — bundled as the mobile
# host's asset, the same way the desktop app renders it. Uses the host build's
# --dump-html mode so templating stays identical across every target.
proj_dump_html() {
  # distinct var names: build_project clobbers the shell-globals name/out/target
  # (POSIX sh has no locals here), so keep our state out of their way.
  dhout="$1"
  dhtgt="$(default_host_target)"
  build_project "$dhtgt" >/dev/null 2>&1 || build_project "$dhtgt"
  dhname="$(jget name "$(basename "$PWD")")"
  "$PWD/build/$dhtgt/$dhname" --dump-html "$dhout" >/dev/null 2>&1 \
    || die "could not render entry template to HTML (--dump-html)"
  [ -s "$dhout" ] || die "rendered HTML is empty: check the entry template"
}

# Android/iOS host builds for a scaffolded project produce a signable app package
# (APK/AAB, .app/IPA), not a bare executable. The gradle-free Android generator
# and the iOS xcodeproj generator bundle proj_dump_html output and sign from the
# resolved keystore / provisioning profile. Being implemented (see
# docs/TOOLING-DISTRIBUTION.md); until then, give a clear pointer, don't crash.
# numeric key from tina4.json (nesting-agnostic; jget only does top-level strings)
jget_num() { n="$(grep -oE "\"$1\"[[:space:]]*:[[:space:]]*[0-9]+" "$PWD/tina4.json" 2>/dev/null | grep -oE '[0-9]+$' | head -1)"; printf '%s' "${n:-$2}"; }

# Package a scaffolded project into a signed APK with ITS OWN applicationId.
# Gradle-free: reuse the reference app's Java/JNI/res, bundle this project's
# rendered UI + icon, and rename the manifest package to the project's bundleId
# (R/Java stay in com.tina4.pascal via --custom-package; the activity is FQCN).
proj_android_build() {
  need_fpc
  BT="$ANDROID_SDK/build-tools/$BT_VER"
  ANDROID_JAR="$ANDROID_SDK/platforms/$PLATFORM_VER/android.jar"
  [ -x "$BT/aapt2" ]     || die "Android build-tools missing → tina4pascal setup android"
  [ -f "$ANDROID_JAR" ]  || die "Android platform $PLATFORM_VER missing → tina4pascal setup android"
  JAVA_HOME="${JAVA_HOME:-$(/usr/libexec/java_home 2>/dev/null || true)}"; export JAVA_HOME
  JAVAC="$JAVA_HOME/bin/javac"; [ -x "$JAVAC" ] || JAVAC="javac"
  command -v "$JAVAC" >/dev/null 2>&1 || die "JDK (javac) required to package APKs"

  work="$PWD/build/android"; host="$work/host"; aout="$work/out"
  mkdir -p "$work"

  # 1. render the entry template → the UI asset MainActivity loads (showcase.html).
  #    Do this FIRST: it builds the desktop host, which clobbers the shell-globals
  #    name/out/target — so read our own config only AFTER it returns.
  proj_dump_html "$work/index.html"

  name="$(jget name "$(basename "$PWD")")"
  title="$(jget title "$name")"
  bundle="$(jget bundleId "com.tina4.$name")"
  minsdk="$(jget_num androidMinSdk 21)"; tgtsdk="$(jget_num androidTargetSdk 34)"
  say "${B}— android: $name ($bundle) —${Z}"
  rm -rf "$host" "$aout"; mkdir -p "$aout/classes"

  # 2. stage the reference host (Java + JNI + res + manifest) and overlay project bits
  mkdir -p "$host"; cp -R "$ROOT/android/." "$host/"
  APPDIR="$host/app/src/main"
  rm -rf "$host/out" "$host"/*.apk "$host"/*.idsig "$APPDIR/jniLibs" 2>/dev/null || true
  mkdir -p "$APPDIR/assets"; cp "$work/index.html" "$APPDIR/assets/showcase.html"
  # bundle the project's assets (icon, images) into the APK; local-asset <img>
  # resolution on Android is a follow-up (see docs/TOOLING-DISTRIBUTION.md).
  [ -d "$PWD/assets" ] && cp -R "$PWD/assets/." "$APPDIR/assets/" 2>/dev/null || true
  [ -f "$PWD/assets/icon.png" ] && find "$APPDIR/res" -name 'ic_launcher*.png' \
    -exec cp "$PWD/assets/icon.png" {} \; 2>/dev/null || true

  # 3. native lib(s) — compile the JNI bridge against the REPO engine (src)
  for abi in ${ABIS:-arm64-v8a}; do
    case "$abi" in
      arm64-v8a)   af="-Tandroid -Paarch64" ;;
      armeabi-v7a) af="-Tandroid -Parm -CpARMV7A -CfVFPV3" ;;
      *) warn "skip unknown ABI $abi"; continue ;;
    esac
    o="$APPDIR/jniLibs/$abi"; mkdir -p "$o"; w="$(mktemp -d)"
    say "${D}fpc $af → libtina4.so ($abi)${Z}"
    "$FPC" -Mdelphi $af -O2 -Xs -Fu"$SRC" -FE"$w" -FU"$w" \
      -o"$o/libtina4.so" "$host/jni/tina4jni.pas" 2>&1 | grep -Ei "error|fatal" \
      && { rm -rf "$w"; die "native build failed ($abi)"; } || true
    [ -f "$o/libtina4.so" ] || { rm -rf "$w"; die "native build produced no .so ($abi)"; }
    rm -rf "$w"
  done

  # 4. Java → dex
  say "${D}javac + d8${Z}"
  "$JAVAC" --release 17 -classpath "$ANDROID_JAR" -d "$aout/classes" \
    $(find "$APPDIR/java" -name '*.java') || die "javac failed"
  "$BT/d8" --min-api "$minsdk" --lib "$ANDROID_JAR" --output "$aout" \
    $(find "$aout/classes" -name '*.class') || die "d8 failed"

  # 5. resources + manifest → applicationId renamed to the project's bundleId
  RES=""
  if [ -d "$APPDIR/res" ]; then "$BT/aapt2" compile --dir "$APPDIR/res" -o "$aout/res.zip"; RES="$aout/res.zip"; fi
  # package=com.tina4.pascal keeps R/Java resolving; activity FQCN so it survives
  # the rename; label shows the project title.
  sed -e 's#<manifest #<manifest package="com.tina4.pascal" #' \
      -e 's#android:name="\.MainActivity"#android:name="com.tina4.pascal.MainActivity"#' \
      -e "s#android:label=\"[^\"]*\"#android:label=\"$title\"#" \
      "$APPDIR/AndroidManifest.xml" > "$aout/AndroidManifest.xml"
  "$BT/aapt2" link -o "$aout/base.apk" -I "$ANDROID_JAR" \
    --manifest "$aout/AndroidManifest.xml" \
    --rename-manifest-package "$bundle" --custom-package com.tina4.pascal \
    --min-sdk-version "$minsdk" --target-sdk-version "$tgtsdk" \
    -A "$APPDIR/assets" $RES || die "aapt2 link failed"

  # 6. add dex + native libs into the APK
  for abi in $(ls "$APPDIR/jniLibs" 2>/dev/null); do
    [ -f "$APPDIR/jniLibs/$abi/libtina4.so" ] || continue
    mkdir -p "$aout/lib/$abi"; cp "$APPDIR/jniLibs/$abi/libtina4.so" "$aout/lib/$abi/"
  done
  ( cd "$aout" && zip -qr base.apk classes*.dex lib ) || die "apk assembly failed"
  "$BT/zipalign" -f -p 4 "$aout/base.apk" "$aout/aligned.apk" || die "zipalign failed"

  # 7. sign: release from env (secret), else the project's committable debug key
  apk="$work/$name.apk"
  if [ -n "${TINA4_KEYSTORE:-}" ]; then
    : "${TINA4_KEY_ALIAS:?set TINA4_KEY_ALIAS for release signing}"
    : "${TINA4_KS_PASS:?set TINA4_KS_PASS for release signing}"
    "$BT/apksigner" sign --ks "$TINA4_KEYSTORE" --ks-pass "pass:$TINA4_KS_PASS" \
      --ks-key-alias "$TINA4_KEY_ALIAS" --key-pass "pass:${TINA4_KEY_PASS:-$TINA4_KS_PASS}" \
      --out "$apk" "$aout/aligned.apk" || die "release signing failed"
    ok "APK (RELEASE-signed) → build/android/$name.apk"
  else
    ks="$PWD/signing/debug.keystore"; [ -f "$ks" ] || ks="$ROOT/android/debug.keystore"
    "$BT/apksigner" sign --ks "$ks" --ks-pass pass:android --key-pass pass:android \
      --out "$apk" "$aout/aligned.apk" || die "debug signing failed"
    ok "APK (debug-signed) → build/android/$name.apk"
  fi
  say "  applicationId ${D}$bundle${Z}"
  say "  install:  ${D}adb install -r \"$apk\"${Z}"
  say "  launch:   ${D}adb shell am start -n $bundle/com.tina4.pascal.MainActivity${Z}"
}
proj_ios_build() {
  warn "scaffolded-project iOS packaging is landing next (docs/TOOLING-DISTRIBUTION.md)."
  say  "  For now use the reference app in ${D}$ROOT/ios${Z}."
  return 0
}
build_project_android() { proj_android_build "$@"; }
build_project_ios()     { proj_ios_build "$@"; }

run_project() {
  target="${1:-$(default_host_target)}"
  build_project "$target"
  name="$(jget name "$(basename "$PWD")")"
  say "→ running build/$target/$name"
  ( exec "$PWD/build/$target/$name" )
}

# run "$exe" "$@" headless. For the linux target with no DISPLAY, wrap in Xvfb so
# render/inspect work on a headless CI/agent box; macOS/Windows render headless.
run_headless() {
  rhexe="$1"; rhtgt="$2"; shift 2
  case "$rhtgt" in
    linux*)
      if [ -z "${DISPLAY:-}" ]; then
        if command -v xvfb-run >/dev/null 2>&1; then
          xvfb-run -a -s "-screen 0 1280x1024x24" "$rhexe" "$@" >/dev/null 2>&1 || true; return 0
        elif command -v Xvfb >/dev/null 2>&1; then
          Xvfb :99 -screen 0 1280x1024x24 >/dev/null 2>&1 & rhx=$!; sleep 1
          DISPLAY=:99 "$rhexe" "$@" >/dev/null 2>&1 || true; kill "$rhx" >/dev/null 2>&1 || true; return 0
        else
          bad "no DISPLAY and no Xvfb — 'sudo apt install xvfb' (or set DISPLAY)"; return 1
        fi
      fi ;;
  esac
  "$rhexe" "$@" >/dev/null 2>&1 || true
}

# build + render one frame headless to an image (so an AI/CI can 'see' it).
# NB: build_project clobbers the shell-global $out/$target/$name (POSIX sh has no
# local scope here), so capture our own values into distinct names first.
# usage: render_project [target] [out] [w] [h] [--overlay]
render_project() {
  rtarget="${1:-$(default_host_target)}"; rout="${2:-shot}"; rw="${3:-900}"; rh="${4:-640}"; rov="${5:-}"
  build_project "$rtarget"
  rname="$(jget name "$(basename "$PWD")")"
  case "$rout" in *.*) : ;; *) case "$rtarget" in linux*) rout="$rout.bmp" ;; *) rout="$rout.png" ;; esac ;; esac
  if [ "$rov" = "--overlay" ]; then
    run_headless "$PWD/build/$rtarget/$rname" "$rtarget" --snapshot "$rout" --overlay --width "$rw" --height "$rh" || return 1
  else
    run_headless "$PWD/build/$rtarget/$rname" "$rtarget" --snapshot "$rout" --width "$rw" --height "$rh" || return 1
  fi
  if [ -f "$rout" ]; then ok "rendered $rout"; echo "$rout"
  else bad "no snapshot produced"; fi
}

# build + emit a JSON inspection dump (dom | boxes | inspect X Y) → prints JSON
dump_project() {
  dkind="$1"; shift
  dtarget="$(default_host_target)"
  build_project "$dtarget"
  dname="$(jget name "$(basename "$PWD")")"
  dexe="$PWD/build/$dtarget/$dname"; dout="$PWD/.tina4-$dkind.json"
  case "$dkind" in
    dom)     run_headless "$dexe" "$dtarget" --dom "$dout" --width 1024 --height 800 ;;
    boxes)   run_headless "$dexe" "$dtarget" --boxes "$dout" --width 1024 --height 800 ;;
    inspect) run_headless "$dexe" "$dtarget" --inspect "${1:-0}" "${2:-0}" "$dout" --width 1024 --height 800 ;;
    *) die "dump: dom | boxes | inspect" ;;
  esac
  if [ -f "$dout" ]; then cat "$dout"; echo; else bad "no $dkind output (linux headless needs Xvfb/DISPLAY)"; fi
}
where_project() { echo "$PWD/build/${1:-$(default_host_target)}/$(jget name "$(basename "$PWD")")"; }

# replay a UI script headlessly (click/type/scroll + snap between steps).
# usage: script_project <scriptfile>
script_project() {
  sfile="${1:-}"; [ -n "$sfile" ] || die "usage: tina4pascal script <scriptfile>"
  [ -f "$sfile" ] || die "script not found: $sfile"
  stgt="$(default_host_target)"
  build_project "$stgt"
  sname="$(jget name "$(basename "$PWD")")"
  run_headless "$PWD/build/$stgt/$sname" "$stgt" --script "$sfile" --width 1024 --height 800 || return 1
  ok "ran script $sfile (snaps written to the paths its 'snap' lines name)"
}

# native gdb debug of the desktop app: build with DWARF symbols, run one headless
# frame under gdb, and print a Pascal backtrace (file:line) on any crash — else
# the app renders and exits clean. usage: debug_native [--break <location>]
debug_native() {
  dbrk=""
  if [ "${1:-}" = "--break" ] && [ -n "${2:-}" ]; then dbrk="$2"; shift 2; fi
  dtgt="$(default_host_target)"
  build_project "$dtgt" --debug
  dname="$(jget name "$(basename "$PWD")")"; dexe="$PWD/build/$dtgt-debug/$dname"
  gbin="$(command -v gdb || true)"
  [ -n "$gbin" ] || { bad "gdb not found — install it (apt install gdb / brew install gdb / choco install mingw)"; return 1; }
  # headless server + linux: run gdb (and its inferior) under Xvfb
  pfx=""
  case "$dtgt" in linux*) [ -z "${DISPLAY:-}" ] && command -v xvfb-run >/dev/null 2>&1 && pfx="xvfb-run -a" ;; esac
  gcf="$PWD/.tina4-gdb"
  { echo "set pagination off"; echo "set confirm off";
    [ -n "$dbrk" ] && echo "break $dbrk";
    echo "run"; echo "bt full"; echo "info locals"; echo "quit"; } > "$gcf"
  say "${D}gdb: run (headless) → backtrace on crash${Z}"
  gout="$($pfx "$gbin" -q -batch -x "$gcf" \
    --args "$dexe" --snapshot /tmp/tina4-dbg.png --width 1024 --height 800 2>&1)"
  rm -f "$gcf"
  printf '%s\n' "$gout"
  if printf '%s' "$gout" | grep -qiE 'received signal|SIGSEGV|SIGABRT|SIGBUS|SIGFPE'; then
    bad "crash caught — backtrace above"
  else
    ok "ran clean under gdb (no crash)"
  fi
}

# scaffold a full Tina4-backend-style project, then build + run it
cmd_init() {
  name=""; norun=0
  for a in "$@"; do case "$a" in --no-run) norun=1 ;; *) [ -z "$name" ] && name="$a" ;; esac; done
  [ -n "$name" ] || die "usage: tina4pascal init <name> [--no-run]"
  [ -e "$name" ] && die "'$name' already exists"
  need_fpc
  title="$(printf '%s' "$name" | awk '{print toupper(substr($0,1,1)) substr($0,2)}')"
  d="$name"
  mkdir -p "$d/migrations" "$d/assets" "$d/src/routes" "$d/src/orm" "$d/src/services" "$d/src/templates" "$d/signing"

  # tina4.json — the project's build config. Uses // comments (the CLI tolerates
  # them) so it explains itself. A clone + `tina4pascal setup` + `build` works on
  # anyone's machine because the project pins tool VERSIONS, not machine paths.
  cat > "$d/tina4.json" <<EOF
{
  // Tina4Pascal project — built by the \`tina4pascal\` CLI. This file is portable:
  // commit it, zip it, clone it anywhere.
  "name": "$name",
  "title": "$title",

  // Entry .pas compiled for desktop targets. Defaults to app.pas in the project
  // root; point it wherever you like (e.g. "src/app/main.pas").
  "main": "app.pas",

  // Reverse-DNS id used by the app stores (Play applicationId / iOS bundle id).
  "bundleId": "com.tina4.$name",

  "window": { "width": 900, "height": 640 },
  "entry":  "src/templates/index.twig",   // Twig template rendered as the UI
  "targets": ["macos", "windows", "linux", "android", "ios"],

  // Tool VERSIONS this project builds against. \`tina4pascal setup\` installs them
  // into ~/.tina4 so a fresh clone reproduces the same build on any computer.
  "toolchain": {
    "fpc": "3.2.2",
    "androidBuildTools": "34.0.0",
    "androidPlatform": "android-34",
    "androidMinSdk": 21,
    "androidTargetSdk": 34
  },

  // Signing. signing/debug.keystore is SAFE to commit (installable debug builds
  // only). The RELEASE key is a SECRET — keep it in ~/.tina4/keystores or point
  // TINA4_KEYSTORE at it, and NEVER commit it. See signing/README.md.
  "android": {
    "signing": {
      "debug":   "signing/debug.keystore",
      "release": { "keystore": "\${TINA4_KEYSTORE}", "alias": "\${TINA4_KEY_ALIAS}" }
    }
  },
  "ios": { "team": "\${TINA4_IOS_TEAM}" }   // Apple Developer Team ID (signing/TestFlight)
}
EOF
  cat > "$d/.gitignore" <<'EOF'
# build outputs
build/
platforms/*/out/
*.o
*.ppu
*.exe
*.apk
*.aab
*.ipa
# per-machine tool overrides
.tina4/
# release signing is SECRET — never commit it (debug key is allowed below)
*.jks
*.keystore
!signing/debug.keystore
EOF
  cat > "$d/signing/README.md" <<'EOF'
# Signing

- **debug.keystore** — committed, shared debug key (password `android`, alias
  `androiddebugkey`). Makes installable *debug* builds reproducibly on any machine.
  It is NOT a secret and NOT accepted by the stores.
- **Release key** — a SECRET you create once and reuse for every update (Play and
  the App Store reject a changed key). Keep it OUT of the repo:

      tina4pascal keygen ~/.tina4/keystores/com.tina4.myapp.jks myalias
      export TINA4_KEYSTORE=~/.tina4/keystores/com.tina4.myapp.jks
      export TINA4_KEY_ALIAS=myalias TINA4_KS_PASS=… TINA4_KEY_PASS=…
      tina4pascal release android      # builds a signed AAB/APK

  `tina4.json.android.signing.release` references these env vars, so the config
  is portable while the key stays private.
EOF
  # committable debug keystore — deterministic installable debug builds anywhere
  if command -v keytool >/dev/null 2>&1; then
    keytool -genkeypair -noprompt -keystore "$d/signing/debug.keystore" \
      -storepass android -keypass android -alias androiddebugkey \
      -dname "CN=Android Debug,O=Android,C=US" -keyalg RSA -keysize 2048 \
      -validity 10000 >/dev/null 2>&1 || true
  fi
  # app.pas — the entry point (configurable via tina4.json "main")
  cat > "$d/app.pas" <<EOF
program $name;
{ $title — Tina4Pascal native app entry point.

  RunApp(Title, TemplateDir, Template, JsonContext, IconPath, Width, Height) opens
  the native window and renders the Twig template (src/templates) as the UI. Edit
  the title/size here or in tina4.json. Event handlers (onclick="Home:hello") live
  in src/routes/*.pas. Build + run with:  tina4pascal run

  This file is the entry point named by tina4.json "main" (default: app.pas). }
{\$mode objfpc}{\$H+}
uses Tina4App;
begin
  RunApp('$title', 'src/templates', 'index.twig', '{"name":"World"}', 'assets/icon.png', 900, 640);
end.
EOF
  printf '# %s\n\nA Tina4Pascal native app. `tina4pascal run` builds and launches it.\nEntry point: `app.pas` (configurable in `tina4.json`).\n' "$title" > "$d/README.md"
  printf -- '-- 0001_init: first migration\n-- CREATE TABLE example (id INTEGER PRIMARY KEY, name TEXT);\n' > "$d/migrations/0001_init.sql"
  : > "$d/src/orm/.gitkeep"; : > "$d/src/services/.gitkeep"
  cat > "$d/src/routes/home.pas" <<'EOF'
unit home;
{ Route handlers for semantic events, e.g. onclick="Home:hello". }
{$mode objfpc}{$H+}
interface
implementation
end.
EOF
  cat > "$d/src/templates/layout.twig" <<'EOF'
<body style="margin:0;font-family:Helvetica,Segoe UI,sans-serif;background:#fbfaf7">
  {% block content %}{% endblock %}
</body>
EOF
  cat > "$d/src/templates/index.twig" <<'EOF'
<body style="margin:0;font-family:Helvetica,Segoe UI,sans-serif;background:#fbfaf7;text-align:center;padding-top:140px">
  <img src="assets/icon.png" width="96" height="96" style="border-radius:22px">
  <h1 style="color:#2b41e6;margin:18px 0 4px;font-size:34px">Hello {{ name }}!</h1>
  <p style="color:#5b5c78;margin:0">Your Tina4Pascal app is running natively.</p>
</body>
EOF
  [ -f "$ROOT/branding/icon.png" ] && cp "$ROOT/branding/icon.png" "$d/assets/icon.png"
  ok "scaffolded ${B}$d/${Z}"
  if [ "$norun" -eq 1 ]; then
    ( cd "$d" && build_project "$(default_host_target)" )   # scaffold + build, no window (AI/MCP)
  else
    ( cd "$d" && run_project "$(default_host_target)" )
  fi
}

