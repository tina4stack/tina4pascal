<!doctype html>
<html><head><style>
/* --- a compact Bootstrap 5 flavour, rendered natively by Tina4 --- */
body{font-family:-apple-system,"Segoe UI",Roboto,sans-serif;background:#f8f9fa;color:#212529;margin:0;padding:16px;font-size:14px}
.container{max-width:760px;margin:0 auto}
h1{font-size:22px;font-weight:600;margin:0}
.text-muted{color:#6c757d}
.small{font-size:12px}
.mb-1{margin-bottom:4px}.mb-2{margin-bottom:8px}.mb-3{margin-bottom:16px}.mt-2{margin-top:8px}.mt-3{margin-top:16px}
.card{background:#fff;border:1px solid #dee2e6;border-radius:8px;margin-bottom:16px}
.card-header{padding:10px 16px;border-bottom:1px solid #dee2e6;font-weight:600;background:#fff;border-radius:8px}
.card-body{padding:16px}
.d-flex{display:flex;gap:10px;align-items:center}
.ms-auto{margin-left:auto}
.badge{display:inline-block;padding:5px 10px;border-radius:20px;font-size:12px;font-weight:600;color:#fff}
.bg-success{background:#198754}
.bg-danger{background:#dc3545}
.btn{display:inline-block;padding:9px 14px;border-radius:7px;font-size:14px;font-weight:500;border:1px solid transparent}
.btn:active{transform:none}
.btn-danger{background:#dc3545;color:#fff}.btn-danger:active{background:#b02a37}
.btn-success{background:#198754;color:#fff}.btn-success:active{background:#146c43}
.btn-primary{background:#0d6efd;color:#fff}.btn-primary:active{background:#0a58ca}
.btn-outline{background:#fff;color:#0d6efd;border-color:#0d6efd}.btn-outline:active{background:#0d6efd;color:#fff}
.btn-secondary{background:#6c757d;color:#fff}.btn-secondary:active{background:#565e64}
.seg{appearance:none;padding:8px 14px;background:#fff;color:#0d6efd;border:1px solid #0d6efd;font-weight:500;font-size:13px}
.seg:checked{background:#0d6efd;color:#fff}
.segL{border-radius:7px 0 0 7px;margin-right:-1px}
.segR{border-radius:0 7px 7px 0}
table{border-collapse:collapse;width:100%;font-size:13px;border:1px solid #dee2e6}
th{text-align:left;padding:8px 10px;border:1px solid #dee2e6;color:#495057;font-weight:600;background:#f8f9fa}
td{padding:8px 10px;border:1px solid #dee2e6}
tr:nth-child(even) td{background:#fbfcfd}
.mono{font-family:"SF Mono",Menlo,monospace}
.redacted{display:inline-block;background:#212529;color:#212529;border-radius:4px;padding:0 2px;letter-spacing:1px}
.console{background:#1e1e28;color:#d6d6e0;border-radius:8px;padding:12px;font-family:Menlo,monospace;font-size:12px;white-space:pre-wrap;line-height:1.6}
.lead{font-size:15px}
.pill{display:inline-block;background:#eef2ff;color:#0d6efd;border-radius:6px;padding:5px 8px;font-size:12px;font-weight:600;margin-right:10px;vertical-align:middle}
</style></head><body>
<div class="container">

  <div class="d-flex mb-2">
    <div>
      <h1>CaptureGuard</h1>
      <div class="text-muted small">Declarative capture protection · HTML-first · one canvas, all platforms</div>
    </div>
    <div class="ms-auto">
      {% if captured %}<span class="badge bg-danger">● CAPTURE ACTIVE</span>
      {% else %}<span class="badge bg-success">● LIVE</span>{% endif %}
    </div>
  </div>

  <div class="card">
    <div class="card-body">
      <div class="d-flex mb-3">
        {% if captured %}
        <span class="btn btn-success" onclick="CG:Capture()">■ Stop simulated capture</span>
        {% else %}
        <span class="btn btn-danger" onclick="CG:Capture()">▶ Simulate a screen capture</span>
        {% endif %}
      </div>
      <div class="mb-2">
        <span class="pill">Policy</span>
        <input type="radio" name="pol" value="All" class="seg segL" {% if policy == 'All' %}checked{% endif %} onclick="CG:Policy(All)">
        <input type="radio" name="pol" value="Sensitive only" class="seg segR" {% if policy == 'Sensitive only' %}checked{% endif %} onclick="CG:Policy(Sensitive only)">
      </div>
      <div class="text-muted small">Everything is drawn by Tina4 on a single canvas — so protection is a per-element render flag, not a per-window OS call. Mark anything <span class="mono">class="sensitive"</span> and it vanishes the instant a capture begins.</div>
    </div>
  </div>

  <div class="card">
    <div class="card-header">Vehicle inventory — the VIN column is marked sensitive</div>
    <div class="card-body">
      <table>
        <tr><th>#</th><th>Stock no</th><th>VIN</th><th>Owner</th><th>Title no</th></tr>
        {% for r in rows %}
        <tr>
          <td class="text-muted">{{ r.n }}</td>
          <td class="mono">{{ r.stock }}</td>
          <td class="mono sensitive">{{ r.vin }}</td>
          <td>{{ r.owner }}</td>
          <td>{{ r.title }}</td>
        </tr>
        {% endfor %}
      </table>
    </div>
  </div>

  <div class="card">
    <div class="card-header">Account panel — also sensitive (shows it isn't just tables)</div>
    <div class="card-body">
      <div class="lead">Balance:
        <span class="mono sensitive" style="display:inline-block">$ 48,215.90</span>
      </div>
      <div class="text-muted small mt-2">A modal or popup would be sensitive the same way — it's just DOM in the same canvas, so there's no separate window to protect.</div>
    </div>
  </div>

  <div class="card">
    <div class="card-header">Log</div>
    <div class="card-body">
      <div class="console">{{ log }}</div>
    </div>
  </div>

</div>
</body></html>
